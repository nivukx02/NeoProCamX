<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Notifications: the ongoing recording foreground-service notification (Android 13+).
         All-files access (MANAGE_EXTERNAL_STORAGE) was removed: every save path uses scoped
         MediaStore / app-specific dirs, so the restricted permission was dead code and a
         Google Play policy blocker. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Sensor Permissions -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- Flashlight -->
    <uses-permission android:name="android.permission.FLASHLIGHT" />

    <!-- Wake lock during recording -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Android 12+: prevent untrusted overlay windows from covering camera controls. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!-- Foreground service for recording -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

    <!-- Hardware features -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.camera.raw" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".NeoProCamXApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeoProCamX"
        android:usesCleartextTraffic="false"
        tools:targetApi="33">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NeoProCamX.Splash"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
                <action android:name="android.media.action.VIDEO_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Gallery Activity -->
        <activity
            android:name=".ui.GalleryActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.MediaPreviewActivity"
            android:exported="false"
            android:parentActivityName=".ui.GalleryActivity" />

        <!-- Recording Foreground Service -->
        <service
            android:name=".recording.RecordingForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!-- User-started offline conversion: mediaProcessing on API 35+, dataSync before API 35. -->
        <service
            android:name=".recording.MediaConversionForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing"
            android:stopWithTask="false" />

        <receiver
            android:name=".ui.DebugCommandReceiver"
            android:enabled="${debugCommandReceiverEnabled}"
            android:exported="${debugCommandReceiverExported}"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.neoproc.neoproccamx.DEBUG_COMMAND" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for sharing captures -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Read-only CamX Studio bridge. Only an RSA-authorized ADB shell holds the platform DUMP
             permission; arbitrary Android applications cannot enumerate or open these artifacts. -->
        <provider
            android:name=".bridge.CamxDesktopBridgeProvider"
            android:authorities="${applicationId}.desktopbridge"
            android:enabled="true"
            android:exported="true"
            android:grantUriPermissions="false"
            android:readPermission="android.permission.DUMP"
            android:writePermission="android.permission.DUMP" />

    </application>

</manifest>
