<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_l" />
            <gradient
                android:angle="270"
                android:startColor="#52B46CFF"
                android:endColor="#20B46CFF" />
            <stroke
                android:width="1dp"
                android:color="@color/accent_yellow" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_l" />
            <solid android:color="#26FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_l" />
            <gradient
                android:angle="270"
                android:startColor="#E112171D"
                android:endColor="#C90A0E12" />
            <stroke
                android:width="1dp"
                android:color="@color/outline_soft" />
        </shape>
    </item>
</selector>
