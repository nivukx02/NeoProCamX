<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_l" />
            <gradient
                android:angle="270"
                android:startColor="#347AD3FF"
                android:endColor="#1A7AD3FF" />
            <stroke
                android:width="1dp"
                android:color="@color/accent_blue" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_l" />
            <gradient
                android:angle="270"
                android:startColor="#24FFFFFF"
                android:endColor="#12000000" />
            <stroke
                android:width="1dp"
                android:color="@color/outline_soft" />
        </shape>
    </item>
</selector>
