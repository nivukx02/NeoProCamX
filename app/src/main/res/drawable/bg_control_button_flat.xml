<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#14FFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#2A7AD3FF"
                android:endColor="#167AD3FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#18161A1F"
                android:endColor="#0F080A0D" />
        </shape>
    </item>
</selector>
