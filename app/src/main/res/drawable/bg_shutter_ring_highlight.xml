<?xml version="1.0" encoding="utf-8"?>
<!-- Shutter accent ring: prominent gold ring inset just inside the outer rim (liquid-glass shutter). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="9dp"
        android:top="9dp"
        android:right="9dp"
        android:bottom="9dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="3dp"
                android:color="@color/accent_yellow" />
        </shape>
    </item>
</layer-list>
