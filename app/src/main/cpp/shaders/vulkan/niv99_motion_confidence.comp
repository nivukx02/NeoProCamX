#version 450

// NIV99 forward/backward motion, rolling-shutter, occlusion, and photometric confidence. Flow is
// expressed in full-resolution pixels and maps a current-frame coordinate into the history frame.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 4, rgba16f) uniform readonly image2D currentLinearInput;
layout(binding = 5, rgba16f) uniform readonly image2D historyLinearInput;
layout(binding = 6, rg16f) uniform readonly image2D forwardFlowInput;
layout(binding = 7, rg16f) uniform readonly image2D backwardFlowInput;
layout(binding = 9, rgba16f) uniform writeonly image2D motionConfidenceOutput;

layout(std140, binding = 15) uniform Niv99UniformBlock {
    ivec4 frameExtent;
    ivec4 tileAndCfa;
    uvec4 identityLow;
    uvec4 identityHigh;
    uvec4 flags;
    vec4 blackLevelRggb;
    vec4 whiteAndThresholds;
    vec4 shotNoiseRggb;
    vec4 readNoiseRggb;
    vec4 whiteBalanceRggb;
    vec4 colorMatrixRow0;
    vec4 colorMatrixRow1;
    vec4 colorMatrixRow2;
    vec4 motionParameters;         // gyro dx/dy, rolling-shutter horizontal skew, flow scale
    vec4 temporalParameters;       // history weight, strength, chroma strength, residual sigma
    vec4 reconstructionParameters;
} uniforms;

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);
const float MIN_VARIANCE = 1e-10;

ivec2 clampCoordinate(ivec2 coordinate) {
    return clamp(coordinate, ivec2(0), uniforms.frameExtent.xy - ivec2(1));
}

vec4 loadHistoryBilinear(vec2 coordinate) {
    vec2 bounded = clamp(coordinate, vec2(0.0), vec2(uniforms.frameExtent.xy - ivec2(1)));
    ivec2 base = ivec2(floor(bounded));
    ivec2 next = min(base + ivec2(1), uniforms.frameExtent.xy - ivec2(1));
    vec2 blend = fract(bounded);
    vec4 upper = mix(imageLoad(historyLinearInput, base),
        imageLoad(historyLinearInput, ivec2(next.x, base.y)), blend.x);
    vec4 lower = mix(imageLoad(historyLinearInput, ivec2(base.x, next.y)),
        imageLoad(historyLinearInput, next), blend.x);
    return mix(upper, lower, blend.y);
}

vec2 loadBackwardFlowBilinear(vec2 coordinate) {
    vec2 bounded = clamp(coordinate, vec2(0.0), vec2(uniforms.frameExtent.xy - ivec2(1)));
    ivec2 base = ivec2(floor(bounded));
    ivec2 next = min(base + ivec2(1), uniforms.frameExtent.xy - ivec2(1));
    vec2 blend = fract(bounded);
    vec2 upper = mix(imageLoad(backwardFlowInput, base).xy,
        imageLoad(backwardFlowInput, ivec2(next.x, base.y)).xy, blend.x);
    vec2 lower = mix(imageLoad(backwardFlowInput, ivec2(base.x, next.y)).xy,
        imageLoad(backwardFlowInput, next).xy, blend.x);
    return mix(upper, lower, blend.y);
}

float currentLuminanceAt(ivec2 coordinate) {
    return dot(max(imageLoad(currentLinearInput, clampCoordinate(coordinate)).rgb, vec3(0.0)), LUMA);
}

float historyLuminanceAt(ivec2 coordinate) {
    return dot(max(imageLoad(historyLinearInput, clampCoordinate(coordinate)).rgb, vec3(0.0)), LUMA);
}

vec2 currentLuminanceGradient(ivec2 coordinate) {
    float left = currentLuminanceAt(coordinate + ivec2(-1, 0));
    float right = currentLuminanceAt(coordinate + ivec2(1, 0));
    float top = currentLuminanceAt(coordinate + ivec2(0, -1));
    float bottom = currentLuminanceAt(coordinate + ivec2(0, 1));
    return vec2(right - left, bottom - top) * 0.5;
}

vec2 historyLuminanceGradient(ivec2 coordinate) {
    float left = historyLuminanceAt(coordinate + ivec2(-1, 0));
    float right = historyLuminanceAt(coordinate + ivec2(1, 0));
    float top = historyLuminanceAt(coordinate + ivec2(0, -1));
    float bottom = historyLuminanceAt(coordinate + ivec2(0, 1));
    return vec2(right - left, bottom - top) * 0.5;
}

float outputLumaVariance(float signal) {
    vec3 rawVariance = vec3(
        uniforms.shotNoiseRggb.x * signal + uniforms.readNoiseRggb.x,
        0.5 * ((uniforms.shotNoiseRggb.y + uniforms.shotNoiseRggb.z) * signal +
            uniforms.readNoiseRggb.y + uniforms.readNoiseRggb.z),
        uniforms.shotNoiseRggb.w * signal + uniforms.readNoiseRggb.w
    );
    vec3 sensorToLuma = vec3(
        LUMA.x * uniforms.colorMatrixRow0.x + LUMA.y * uniforms.colorMatrixRow1.x +
            LUMA.z * uniforms.colorMatrixRow2.x,
        LUMA.x * uniforms.colorMatrixRow0.y + LUMA.y * uniforms.colorMatrixRow1.y +
            LUMA.z * uniforms.colorMatrixRow2.y,
        LUMA.x * uniforms.colorMatrixRow0.z + LUMA.y * uniforms.colorMatrixRow1.z +
            LUMA.z * uniforms.colorMatrixRow2.z
    );
    vec3 gains = vec3(
        uniforms.whiteBalanceRggb.x,
        0.5 * (uniforms.whiteBalanceRggb.y + uniforms.whiteBalanceRggb.z),
        uniforms.whiteBalanceRggb.w
    );
    vec3 coefficients = sensorToLuma * gains;
    return max(dot(coefficients * coefficients, max(rawVariance, vec3(0.0))), MIN_VARIANCE);
}

void main() {
    ivec2 coordinate = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(coordinate, uniforms.frameExtent.xy))) return;
    if (uniforms.flags.y == 0u || uniforms.flags.z != 0u) {
        imageStore(motionConfidenceOutput, coordinate, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    float scanline = (float(coordinate.y) + 0.5) / max(float(uniforms.frameExtent.y), 1.0) - 0.5;
    vec2 rollingShutterOffset = vec2(uniforms.motionParameters.z * scanline, 0.0);
    vec2 gyroOffset = uniforms.motionParameters.xy * scanline;
    vec2 forwardFlow = imageLoad(forwardFlowInput, coordinate).xy * uniforms.motionParameters.w;
    vec2 totalFlow = forwardFlow + rollingShutterOffset + gyroOffset;
    vec2 historyCoordinate = vec2(coordinate) + totalFlow;
    vec2 upper = vec2(uniforms.frameExtent.xy - ivec2(1));
    bool inside = all(greaterThanEqual(historyCoordinate, vec2(0.0))) &&
        all(lessThanEqual(historyCoordinate, upper));
    if (!inside) {
        imageStore(motionConfidenceOutput, coordinate, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec2 backwardFlow = loadBackwardFlowBilinear(historyCoordinate) *
        uniforms.motionParameters.w;
    float consistencyError = length(forwardFlow + backwardFlow);
    float flowMagnitude = length(totalFlow);
    float consistencyThreshold = 0.35 + 0.08 * flowMagnitude;
    float consistencyConfidence = 1.0 - smoothstep(
        consistencyThreshold,
        consistencyThreshold * 3.0,
        consistencyError
    );

    vec3 current = max(imageLoad(currentLinearInput, coordinate).rgb, vec3(0.0));
    vec3 history = max(loadHistoryBilinear(historyCoordinate).rgb, vec3(0.0));
    float currentLuma = dot(current, LUMA);
    float historyLuma = dot(history, LUMA);
    float variance = outputLumaVariance(max(currentLuma, historyLuma));
    float residualScale = max(uniforms.temporalParameters.w, 0.5);
    float normalizedResidual = abs(currentLuma - historyLuma) /
        max(sqrt(2.0 * variance) * residualScale, 1e-5);
    float residualConfidence = exp(-0.5 * min(normalizedResidual * normalizedResidual, 32.0));

    vec2 currentGradient = currentLuminanceGradient(coordinate);
    ivec2 historyBase = ivec2(round(historyCoordinate));
    vec2 historyGradient = historyLuminanceGradient(historyBase);
    float gradientScale = max(length(currentGradient) + length(historyGradient), 1e-4);
    float gradientMismatch = length(currentGradient - historyGradient) / gradientScale;
    float structureConfidence = 1.0 - smoothstep(0.18, 0.82, gradientMismatch);

    vec3 chromaCurrent = current - vec3(currentLuma);
    vec3 chromaHistory = history - vec3(historyLuma);
    float chromaResidual = length(chromaCurrent - chromaHistory);
    float chromaConfidence = 1.0 - smoothstep(
        max(0.01, sqrt(variance) * 2.0),
        max(0.04, sqrt(variance) * 7.0),
        chromaResidual
    );
    float occlusionConfidence = consistencyConfidence * residualConfidence;
    float confidence = clamp(
        occlusionConfidence * mix(0.45, 1.0, structureConfidence) *
            mix(0.60, 1.0, chromaConfidence),
        0.0,
        1.0
    );
    float normalizedMagnitude = clamp(flowMagnitude /
        max(length(vec2(uniforms.frameExtent.xy)), 1.0), 0.0, 1.0);
    imageStore(motionConfidenceOutput, coordinate, vec4(
        confidence,
        occlusionConfidence,
        residualConfidence,
        normalizedMagnitude
    ));
}
