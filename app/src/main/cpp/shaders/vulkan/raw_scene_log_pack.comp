#version 450

// Full-resolution, project-owned transport used only when the device cannot export the cinema
// demosaic's RGBA16F AHardwareBuffer. The source remains device-local FP16 ACEScg. This pass maps the
// non-negative scene-linear values into a packed 10-bit RGB AHardwareBuffer without applying a display
// transfer, tone curve, gamut conversion, or vendor HDR technology. The offscreen encoder applies the
// exact inverse before the canonical NDR10+/NIVUKX operator.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba16f) uniform readonly image2D acescgInput;
layout(binding = 1, rgb10_a2) uniform writeonly image2D sceneLogOutput;

layout(push_constant) uniform RawSceneLogPackPushConstants {
    int width;
    int height;
} pushConstants;

// NEO-SCENE-LOG10-v1. The slope gives dense shadow/midtone allocation while the 256.0 ceiling retains
// more than ten stops above 18% gray. Values are independently log-coded per channel to preserve
// highlight hue ratios; black and the upper endpoint are exact.
const float NEO_SCENE_LOG_SLOPE = 32.0;
const float NEO_SCENE_LOG_MAX_LINEAR = 256.0;
const float NEO_SCENE_LOG_DENOMINATOR = 13.000176099; // log2(1 + 32 * 256)

vec3 encodeNeoSceneLog10(vec3 linearAcesCg) {
    vec3 bounded = clamp(linearAcesCg, vec3(0.0), vec3(NEO_SCENE_LOG_MAX_LINEAR));
    return log2(vec3(1.0) + NEO_SCENE_LOG_SLOPE * bounded) /
        NEO_SCENE_LOG_DENOMINATOR;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= pushConstants.width || pixel.y >= pushConstants.height) return;

    vec3 acescg = max(imageLoad(acescgInput, pixel).rgb, vec3(0.0));
    imageStore(sceneLogOutput, pixel, vec4(encodeNeoSceneLog10(acescg), 1.0));
}
