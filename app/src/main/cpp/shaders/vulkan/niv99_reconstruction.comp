#version 450

// NIV99 detail-safe reconstruction and rendering-only local illuminant field. Tile controls are
// bilinearly interpolated, so no tile boundary can become a hard processing boundary.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 8, rgba16f) uniform readonly image2D semanticProtectionInput;
layout(binding = 10, rgba16f) uniform readonly image2D temporalInput;
layout(binding = 11, rgba16f) uniform writeonly image2D reconstructedOutput;

struct Niv99TileControlRecord {
    vec4 denoise;
    vec4 protection;
    vec4 thresholds;
    vec4 illuminant;
};

layout(std430, binding = 13) readonly buffer Niv99TileControlBuffer {
    Niv99TileControlRecord controls[];
} tileControlInput;

layout(std140, binding = 15) uniform Niv99UniformBlock {
    ivec4 frameExtent;
    ivec4 tileAndCfa;
    uvec4 identityLow;
    uvec4 identityHigh;
    uvec4 flags;
    vec4 blackLevelRggb;
    vec4 whiteAndThresholds;
    vec4 shotNoiseRggb;
    vec4 readNoiseRggb;
    vec4 whiteBalanceRggb;
    vec4 colorMatrixRow0;
    vec4 colorMatrixRow1;
    vec4 colorMatrixRow2;
    vec4 motionParameters;
    vec4 temporalParameters;
    vec4 reconstructionParameters; // strength, ceiling, noise sigma, halo limit
} uniforms;

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

ivec2 clampCoordinate(ivec2 coordinate) {
    return clamp(coordinate, ivec2(0), uniforms.frameExtent.xy - ivec2(1));
}

vec3 loadRgb(ivec2 coordinate) {
    return max(imageLoad(temporalInput, clampCoordinate(coordinate)).rgb, vec3(0.0));
}

float loadLuma(ivec2 coordinate) {
    return dot(loadRgb(coordinate), LUMA);
}

Niv99TileControlRecord loadControl(ivec2 tileCoordinate) {
    ivec2 bounded = clamp(tileCoordinate, ivec2(0), uniforms.frameExtent.zw - ivec2(1));
    uint index = uint(bounded.y * uniforms.frameExtent.z + bounded.x);
    return tileControlInput.controls[index];
}

void interpolatedControl(
    ivec2 coordinate,
    out vec4 denoise,
    out vec4 protection,
    out vec4 thresholds,
    out vec4 illuminant
) {
    vec2 tileSize = max(vec2(uniforms.tileAndCfa.xy), vec2(1.0));
    vec2 tilePosition = (vec2(coordinate) + vec2(0.5)) / tileSize - vec2(0.5);
    ivec2 base = ivec2(floor(tilePosition));
    vec2 blend = fract(tilePosition);
    Niv99TileControlRecord c00 = loadControl(base);
    Niv99TileControlRecord c10 = loadControl(base + ivec2(1, 0));
    Niv99TileControlRecord c01 = loadControl(base + ivec2(0, 1));
    Niv99TileControlRecord c11 = loadControl(base + ivec2(1, 1));
    denoise = mix(mix(c00.denoise, c10.denoise, blend.x),
        mix(c01.denoise, c11.denoise, blend.x), blend.y);
    protection = mix(mix(c00.protection, c10.protection, blend.x),
        mix(c01.protection, c11.protection, blend.x), blend.y);
    thresholds = mix(mix(c00.thresholds, c10.thresholds, blend.x),
        mix(c01.thresholds, c11.thresholds, blend.x), blend.y);
    illuminant = mix(mix(c00.illuminant, c10.illuminant, blend.x),
        mix(c01.illuminant, c11.illuminant, blend.x), blend.y);
}

vec3 applyLocalIlluminant(vec3 rgb, vec4 illuminant, float skinConfidence) {
    float protection = clamp(skinConfidence, 0.0, 1.0) * 0.70;
    float confidence = clamp(illuminant.w, 0.0, 1.0) * (1.0 - protection);
    vec3 gain = mix(vec3(1.0), clamp(illuminant.xyz, vec3(0.5), vec3(2.0)), confidence);
    vec3 corrected = max(rgb * gain, vec3(0.0));
    float peak = max(corrected.r, max(corrected.g, corrected.b));
    if (peak > 1.0 && max(rgb.r, max(rgb.g, rgb.b)) <= 1.0) {
        // Preserve hue while consuming only existing headroom; local WB must not create clipping.
        corrected /= peak;
    }
    return corrected;
}

vec3 edgeAwareChromaCleanup(ivec2 coordinate, vec3 center, float strength, float edgeGuard) {
    if (strength <= 1e-5) return center;
    float centerLuma = dot(center, LUMA);
    vec3 centerChroma = center - vec3(centerLuma);
    vec3 chromaSum = centerChroma * 2.0;
    float weightSum = 2.0;
    const ivec2 offsets[4] = ivec2[4](
        ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1)
    );
    for (int index = 0; index < 4; ++index) {
        vec3 sampleRgb = loadRgb(coordinate + offsets[index]);
        float sampleLuma = dot(sampleRgb, LUMA);
        float lumaDifference = abs(sampleLuma - centerLuma);
        float weight = exp(-lumaDifference / max(0.012 + 0.06 * (1.0 - edgeGuard), 1e-5));
        chromaSum += (sampleRgb - vec3(sampleLuma)) * weight;
        weightSum += weight;
    }
    vec3 cleanedChroma = chromaSum / max(weightSum, 1e-5);
    float admitted = clamp(strength * (1.0 - 0.72 * edgeGuard), 0.0, 0.78);
    return vec3(centerLuma) + mix(centerChroma, cleanedChroma, admitted);
}

void main() {
    ivec2 coordinate = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(coordinate, uniforms.frameExtent.xy))) return;
    vec4 source = imageLoad(temporalInput, coordinate);
    vec3 center = max(source.rgb, vec3(0.0));
    vec4 denoise;
    vec4 protection;
    vec4 thresholds;
    vec4 illuminant;
    interpolatedControl(coordinate, denoise, protection, thresholds, illuminant);

    vec4 semantic = clamp(imageLoad(semanticProtectionInput, coordinate), vec4(0.0), vec4(1.0));
    float semanticDetail = max(max(semantic.y, semantic.z), semantic.w);
    float edgeProtection = max(clamp(protection.x, 0.0, 1.0), semanticDetail);
    float textureProtection = max(clamp(protection.y, 0.0, 1.0), semanticDetail);
    center = applyLocalIlluminant(center, illuminant, max(semantic.x, protection.z));
    center = max(edgeAwareChromaCleanup(
        coordinate,
        center,
        clamp(denoise.z, 0.0, 1.0),
        edgeProtection
    ), vec3(0.0));

    float l00 = loadLuma(coordinate + ivec2(-1, -1));
    float l10 = loadLuma(coordinate + ivec2(0, -1));
    float l20 = loadLuma(coordinate + ivec2(1, -1));
    float l01 = loadLuma(coordinate + ivec2(-1, 0));
    float l11 = dot(center, LUMA);
    float l21 = loadLuma(coordinate + ivec2(1, 0));
    float l02 = loadLuma(coordinate + ivec2(-1, 1));
    float l12 = loadLuma(coordinate + ivec2(0, 1));
    float l22 = loadLuma(coordinate + ivec2(1, 1));
    float gradientX = (l20 + 2.0 * l21 + l22 - l00 - 2.0 * l01 - l02) * 0.125;
    float gradientY = (l02 + 2.0 * l12 + l22 - l00 - 2.0 * l10 - l20) * 0.125;
    float tensorXX = gradientX * gradientX;
    float tensorYY = gradientY * gradientY;
    float tensorXY = gradientX * gradientY;
    float trace = tensorXX + tensorYY;
    float determinant = max(tensorXX * tensorYY - tensorXY * tensorXY, 0.0);
    float discriminant = sqrt(max(trace * trace * 0.25 - determinant, 0.0));
    float lambdaHigh = trace * 0.5 + discriminant;
    float lambdaLow = trace * 0.5 - discriminant;
    float coherence = (lambdaHigh - lambdaLow) / max(lambdaHigh + lambdaLow, 1e-7);
    float localMean = (l00 + l10 + l20 + l01 + 4.0 * l11 + l21 + l02 + l12 + l22) / 12.0;
    float detailResidual = l11 - localMean;
    float noiseSigma = max(uniforms.reconstructionParameters.z, thresholds.x * 0.5);
    float noiseGate = smoothstep(noiseSigma, noiseSigma * 3.5 + 1e-6, abs(detailResidual));
    float structureGate = max(edgeProtection, textureProtection * mix(0.70, 1.0, coherence));
    float sharpening = min(
        clamp(protection.w, 0.0, 1.0),
        clamp(uniforms.reconstructionParameters.y, 0.0, 1.0)
    ) * clamp(uniforms.reconstructionParameters.x, 0.0, 1.0) * noiseGate * structureGate;
    sharpening *= 1.0 - 0.72 * clamp(semantic.x, 0.0, 1.0);

    float sharpenedLuma = max(l11 + detailResidual * sharpening, 0.0);
    vec3 reconstructed = center;
    if (l11 > 1e-6) reconstructed *= sharpenedLuma / l11;
    vec3 neighbourhoodMin = min(min(min(loadRgb(coordinate + ivec2(-1, 0)),
        loadRgb(coordinate + ivec2(1, 0))), loadRgb(coordinate + ivec2(0, -1))),
        loadRgb(coordinate + ivec2(0, 1)));
    vec3 neighbourhoodMax = max(max(max(loadRgb(coordinate + ivec2(-1, 0)),
        loadRgb(coordinate + ivec2(1, 0))), loadRgb(coordinate + ivec2(0, -1))),
        loadRgb(coordinate + ivec2(0, 1)));
    neighbourhoodMin = min(neighbourhoodMin, center);
    neighbourhoodMax = max(neighbourhoodMax, center);
    float haloAllowance = clamp(uniforms.reconstructionParameters.w, 0.0, 0.10) *
        max(neighbourhoodMax.r - neighbourhoodMin.r,
            max(neighbourhoodMax.g - neighbourhoodMin.g,
                neighbourhoodMax.b - neighbourhoodMin.b));
    reconstructed = clamp(reconstructed,
        max(neighbourhoodMin - vec3(haloAllowance), vec3(0.0)),
        neighbourhoodMax + vec3(haloAllowance));
    imageStore(reconstructedOutput, coordinate, vec4(reconstructed, source.a));
}
