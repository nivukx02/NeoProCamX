uint applyBlueNoiseDither(uint sampleIndex, uint sampleValue) {
    if (p010ZeroVisibleGrainExport()) return sampleValue;
    uint width = max(pushData.width, 1u);
    uint x = sampleIndex - (sampleIndex / width) * width;
    uint y = sampleIndex / width;
    uint matrixIndex = ((y & 7u) << 3u) + (x & 7u);
    float centeredBlueNoise = (float(BLUE_NOISE_8X8[int(matrixIndex)]) - 31.5) / 31.5;
    float exportNoiseShape = p010ExportNoiseShape();
    float amplitude = clamp(0.35 + exportNoiseShape * 0.18, 0.0, 1.0) * abrDitherAmplitudeScale();
    float dither = centeredBlueNoise * amplitude * 2.0;
    float quantized = float(sampleValue) + (dither >= 0.33 ? 1.0 : (dither <= -0.33 ? -1.0 : 0.0));
    return uint(clamp(quantized, 0.0, 1023.0));
}

uint applyPhaseShiftedFilmGrain(uint sampleIndex, uint sampleValue) {
    if (p010ZeroVisibleGrainExport()) return sampleValue;
    uint width = max(pushData.width, 1u);
    uint x = sampleIndex - (sampleIndex / width) * width;
    uint y = sampleIndex / width;
    uint phase = uint(clamp(uniforms.temporalLumaBlend * 11.0 + p010ExportNoiseShape() * 17.0, 0.0, 63.0));
    uint matrixIndex = (((y + phase) & 7u) << 3u) + ((x + (phase >> 1u)) & 7u);
    float grain = (float(BLUE_NOISE_8X8[int(matrixIndex)]) - 31.5) / 31.5;
    float shadowWeight = 1.0 - smoothstep(256.0, 760.0, float(sampleValue));
    float highlightProtect = 1.0 - smoothstep(820.0, 1000.0, float(sampleValue));
    float amplitude = clamp(p010ExportNoiseShape() * 0.42 + 0.10, 0.0, 0.55) * abrDitherAmplitudeScale();
    float signedLift = grain * amplitude * shadowWeight * highlightProtect;
    return uint(clamp(float(sampleValue) + signedLift, 0.0, 1023.0));
}

uint applyWarmHighlightHalation(uint sampleIndex, uint sampleValue) {
    uint width = max(pushData.width, 1u);
    uint height = max(pushData.height, 1u);
    uint row = sampleIndex / width;
    uint column = sampleIndex - row * width;
    if (row == 0u || column == 0u || row + 1u >= height || column + 1u >= width) return sampleValue;
    uint north = unpackP010(readCurrentP010Sample(sampleIndex - width));
    uint south = unpackP010(readCurrentP010Sample(sampleIndex + width));
    uint west = unpackP010(readCurrentP010Sample(sampleIndex - 1u));
    uint east = unpackP010(readCurrentP010Sample(sampleIndex + 1u));
    float computedNeighborPeak = max(max(float(north), float(south)), max(float(west), float(east)));
    float highlightBleed = smoothstep(820.0, 1010.0, computedNeighborPeak) *
        smoothstep(64.0, 260.0, computedNeighborPeak - float(sampleValue));
    return uint(clamp(float(sampleValue) + highlightBleed * 2.0, 0.0, 1023.0));
}

float planckBlueNoiseJndThreshold(uint sampleValue) {
    float luma = clamp(float(sampleValue) / 1023.0, 0.0, 1.0);
    float shadowSensitivity = mix(1.45, 0.72, smoothstep(0.03, 0.34, luma));
    float highlightProtect = 1.0 - smoothstep(0.82, 1.0, luma);
    return clamp((0.35 + sqrt(max(luma, 0.0)) * 0.62) * shadowSensitivity * highlightProtect, 0.0, 1.0);
}

uint applyPlanckBlueNoiseJndDither(uint sampleIndex, uint sampleValue) {
    uint width = max(pushData.width, 1u);
    uint x = sampleIndex - (sampleIndex / width) * width;
    uint y = sampleIndex / width;
    uint phase = uint(clamp(uniforms.temporalBlend * 23.0 + p010ExportNoiseShape() * 29.0, 0.0, 63.0));
    uint matrixIndex = (((y + phase) & 7u) << 3u) + ((x + phase * 3u) & 7u);
    float blue = (float(BLUE_NOISE_8X8[int(matrixIndex)]) - 31.5) / 31.5;
    float jnd = planckBlueNoiseJndThreshold(sampleValue);
    float shaped = blue * jnd * abrDitherAmplitudeScale() * JND_EXPORT_DITHER_VISIBILITY_SCALE;
    float quantized = float(sampleValue) + (shaped >= 0.50 ? 1.0 : (shaped <= -0.50 ? -1.0 : 0.0));
    return uint(clamp(quantized, 0.0, 1023.0));
}

uint applyFitzHughNagumoChemicalHalation(uint sampleIndex, uint sampleValue) {
    float activator = smoothstep(820.0, 1023.0, float(sampleValue));
    float inhibitor = smoothstep(128.0, 640.0, float(sampleValue));
    for (int step = 0; step < 4; step++) {
        float reaction = activator - activator * activator * activator * 0.3333 - inhibitor + 0.045;
        inhibitor += 0.14 * (activator + 0.58 - 0.80 * inhibitor);
        activator = clamp(activator + reaction * 0.20, 0.0, 1.0);
    }
    float warmthLift = activator * (1.0 - smoothstep(940.0, 1023.0, float(sampleValue))) * 2.0;
    return uint(clamp(float(sampleValue) + warmthLift, 0.0, 1023.0));
}

uint applyPlanckGrain(uint sampleIndex, uint sampleValue) {
    if (p010ZeroVisibleGrainExport()) return sampleValue;
    uint width = max(pushData.width, 1u);
