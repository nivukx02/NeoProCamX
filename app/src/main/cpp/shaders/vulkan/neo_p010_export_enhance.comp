#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#define NEO_ACESCG_NON_CERTIFIED 1
#define ACESCG_LINEAR_WORKING_SPACE 1
#define FP32_BAYESIAN_PIPELINE 1
#define PHASE_SHIFTED_FILM_GRAIN 1
#define OMNIPOTENT_NPV10_EXPORT_PIPELINE 1
#define ZENITH_COSMIC_PLANCK_NPV10_EXPORT_PIPELINE 1

// ── NDR10+ / NIVUKX genuine full-RGB → PQ delivery (Phase 1) ─────────────────
// When enabled, NDR10+/NIVUKX recorded pixels are reconstructed to real RGB,
// run through the canonical NeoProCamX color engine (hue-preserving tone,
// 203-nit diffuse-white anchor, master-peak shoulder) and re-encoded to genuine
// PQ (ST.2084) — NOT plain HLG and NOT the old gray-fed luma curve. ENABLED (1)
// in lock-step with the encoder/container ST.2084 retag in
// RecordingHdrVideoLookPolicy, so the recorded pixels and the container tag are
// a coherent PQ HDR10 stream. Mirrors the host-golden com.neoproc.neoproccamx
// .color.NdrNivukxDeliveryEngine (CPU↔GPU parity is source-locked in tests).
// Legacy Camera2-P010 -> HLG-linear -> NDR delivery is deliberately compile-disabled. Proprietary
// NDR10+/NIVUKX pixels are produced only by the RAW_SENSOR -> ACEScg -> offscreen delivery path.
// Generic P010 enhancement remains available for non-NDR modes.
#define NEO_PQ_DELIVERY_ENABLED 0

layout(std430, set = 0, binding = 0) readonly buffer CurrentP010 {
    uint currentData[];
};

layout(std430, set = 0, binding = 1) readonly buffer PreviousP010 {
    uint previousData[];
};

layout(std430, set = 0, binding = 2) buffer OutputP010 {
    uint outputData[];
};

layout(push_constant) uniform EnhancementPushConstants {
    uint width;
    uint height;
    uint hasPreviousFrame;
} pushData;

// The Riven motion search used to issue 441 uncached SSBO reads per luma invocation, followed by
// another 12 reads for the directional deblur. A 16x16 workgroup needs only a six-pixel halo to
// cover both the +/-3 search with a 3x3 patch and every deblur tap. Cooperatively cache that 28x28
// footprint once (6.125 reads/invocation for both frames) and preserve the exact search, tie-break,
// edge-clamp, FP32 math, and output packing. 6.125 KiB is below Vulkan's mandatory 16-KiB
// maxComputeSharedMemorySize floor, so this remains portable to every conformant Vulkan device.
const int RIVEN_TILE_HALO = 6;
const int RIVEN_WORKGROUP_EDGE = 16;
const int RIVEN_TILE_EDGE = RIVEN_WORKGROUP_EDGE + RIVEN_TILE_HALO * 2;
const int RIVEN_TILE_SAMPLE_COUNT = RIVEN_TILE_EDGE * RIVEN_TILE_EDGE;
shared uint rivenCurrentLumaTile[RIVEN_TILE_SAMPLE_COUNT];
shared uint rivenPreviousLumaTile[RIVEN_TILE_SAMPLE_COUNT];

struct EnhancementUniforms {
    float signalFamily;
    float colorSpace;
    float colorScience;
    float activeTransport;
    float temporalBlend;
    float spatialDenoise;
    float chromaDenoise;
    float shadowBoost;
    float sharpening;
    float warmth;
    float contrast;
    float saturation;
    float highlightCompression;
    float logStrength;
    float videoHdrFusionStrength;
    float shadowChromaDeadband;
    float aliasSafeMaxDetailDelta;
    float fineTextureThreshold;
    float mediumEdgeThreshold;
    float strongEdgeThreshold;
    float fineTextureDetailGain;
    float mediumDetailGain;
    float strongDetailGain;
    float temporalLumaBlend;
    float temporalChromaBlend;
    float iso;
    float noiseMetric;
    float localChromaSpikeSmoothing;
    float sharpeningFloor;
    float sharpeningCeiling;
    float skinDetailProtection;
    float migrationApplied;
    float dualGainFusionEnabled;
    float dualGainMotionMaskEnabled;
    float dualGainKGain;
    float dualGainNoiseFloor;
    float dualGainSaturationThreshold;
    float dualGainTimestampSkew;
    float shotNoiseCoefficient;
    float readNoiseCoefficient;
};

layout(std430, set = 0, binding = 3) readonly buffer UniformBlock {
    EnhancementUniforms uniforms;
};

const int COLOR_SCIENCE_NDR10_PLUS = 20;
const int COLOR_SCIENCE_NIVUKX_VISION = 21;
const int COLOR_SCIENCE_NEO_ACES_HIGH_END = 31;
const int COLOR_SCIENCE_COSMIC_SINGULARITY = COLOR_SCIENCE_NDR10_PLUS;
const int COLOR_SPACE_NEO_ACES_AP1 = 4;
const int COLOR_SPACE_NEO_ACES_AP0 = 5;
const int SIGNAL_FAMILY_SDR = 1;
const int SIGNAL_FAMILY_HDR = 2;
const int SIGNAL_FAMILY_LOG = 3;
const int SIGNAL_FAMILY_RAW = 4;
const int ACTIVE_TRANSPORT_REC709_SDR = 1;
const int ACTIVE_TRANSPORT_BT2020_SDR = 2;
// Matches GpuActiveTransport.BT2100_PQ_MAIN10 (id 4) — the NDR/NIVUKX PQ delivery transport.
const int ACTIVE_TRANSPORT_BT2100_PQ = 4;
const uint kP010LaneMask = 0xFFFFu;
const int COHERENT_CHROMA_MIN_DELTA = 96;
const int COHERENT_CHROMA_SUPPORT_WINDOW = 48;
const float COHERENT_CHROMA_RETAIN_FLOOR = 0.44;
const float JND_EXPORT_DITHER_VISIBILITY_SCALE = 0.28;
const float P010_MAX_TEMPORAL_PREVIOUS_WEIGHT = 0.72;
const float P010_MAX_CUMULATIVE_DETAIL_CODES = 40.0;

uint unpackP010(uint packedValue) {
    return clamp(packedValue >> 6u, 0u, 1023u);
}

uint packP010(uint sampleValue) {
    return clamp(sampleValue, 0u, 1023u) << 6u;
}

uint packedWordIndex(uint sampleIndex) {
    return sampleIndex >> 1u;
}

uint packedLaneShift(uint sampleIndex) {
    return (sampleIndex & 1u) * 16u;
}

uint unpackPackedP010Lane(uint packedWord, uint sampleIndex) {
    return (packedWord >> packedLaneShift(sampleIndex)) & kP010LaneMask;
}

uint readCurrentP010Sample(uint sampleIndex) {
    uint wordIndex = sampleIndex >> 1u;
    return unpackPackedP010Lane(currentData[wordIndex], sampleIndex);
}

uint readPreviousP010Sample(uint sampleIndex) {
    uint wordIndex = sampleIndex >> 1u;
    return unpackPackedP010Lane(previousData[wordIndex], sampleIndex);
}

void loadRivenLumaTiles() {
    int width = int(max(pushData.width, 1u));
    int height = int(max(pushData.height, 1u));
    int originX = int(gl_WorkGroupID.x) * RIVEN_WORKGROUP_EDGE - RIVEN_TILE_HALO;
    int originY = int(gl_WorkGroupID.y) * RIVEN_WORKGROUP_EDGE - RIVEN_TILE_HALO;
    const uint workgroupInvocationCount = 16u * 16u;

    for (
        uint tileIndex = gl_LocalInvocationIndex;
        tileIndex < uint(RIVEN_TILE_SAMPLE_COUNT);
        tileIndex += workgroupInvocationCount
    ) {
        int tileX = int(tileIndex) - (int(tileIndex) / RIVEN_TILE_EDGE) * RIVEN_TILE_EDGE;
        int tileY = int(tileIndex) / RIVEN_TILE_EDGE;
        int sourceX = clamp(originX + tileX, 0, width - 1);
        int sourceY = clamp(originY + tileY, 0, height - 1);
        uint sourceIndex = uint(sourceY * width + sourceX);
        uint currentValue = unpackP010(readCurrentP010Sample(sourceIndex));
        rivenCurrentLumaTile[tileIndex] = currentValue;
        rivenPreviousLumaTile[tileIndex] = pushData.hasPreviousFrame != 0u
            ? unpackP010(readPreviousP010Sample(sourceIndex))
            : currentValue;
    }
    memoryBarrierShared();
    barrier();
}

void writePackedP010Sample(uint sampleIndex, uint sampleValue) {
    uint wordIndex = sampleIndex >> 1u;
    uint lane = sampleIndex & 1u;
    uint shift = lane * 16u;
    uint laneMask = kP010LaneMask << shift;
    uint oldWord = outputData[wordIndex];
    while (true) {
        uint preservedWord = oldWord & ~laneMask;
        uint newWord = preservedWord | ((packP010(sampleValue) & kP010LaneMask) << shift);
        uint observedWord = atomicCompSwap(outputData[wordIndex], oldWord, newWord);
        if (observedWord == oldWord) return;
        oldWord = observedWord;
    }
}

uint blendSample(uint currentValue, uint previousValue, float weight) {
    float blended = float(currentValue) * (1.0 - weight) + float(previousValue) * weight;
    return uint(clamp(blended + 0.5, 0.0, 1023.0));
}

float heteroscedasticNoiseVariance(float normalizedLuma) {
    return max(
        uniforms.shotNoiseCoefficient * clamp(normalizedLuma, 0.0, 1.0) +
            uniforms.readNoiseCoefficient,
        0.00000002
    );
}

float bayesShrinkThreshold(float noiseVariance, float signalSigma) {
    return (noiseVariance * 0.064) / max(signalSigma, 0.0005);
}

float bayesianWaveletShrink(float coefficient, float normalizedLuma, float signalSigma) {
    float threshold = bayesShrinkThreshold(heteroscedasticNoiseVariance(normalizedLuma), signalSigma);
    return sign(coefficient) * max(abs(coefficient) - threshold, 0.0);
}

float p010NormalizeStrength(float rawStrength) {
    return clamp(rawStrength > 1.0 ? rawStrength * 0.1 : rawStrength, 0.0, 1.0);
}

float p010StrictNormalProSdrExportAuthority();
float p010StrictVisibleCleanExportAuthority();
bool p010ZeroVisibleGrainExport();
float p010ExportStrictCeiling();
float p010ExportNoiseShape();
float p010ExportLocalChromaSpikeShape();

float abrBackpressureScale() {
    // Export reads the initial 40 fields of the shared 44-float uniform ABI.
    // The subject-mask tail is ignored until export receives mask input.
    float pressure = smoothstep(0.72, 1.0, p010ExportNoiseShape());
    return clamp(1.0 - pressure * 0.30, 0.60, 1.0);
}

float abrDetailGainScale() {
    return clamp(mix(1.0, 0.78, 1.0 - abrBackpressureScale()), 0.68, 1.0);
}

float abrDitherAmplitudeScale() {
    return clamp(mix(1.0, 0.72, 1.0 - abrBackpressureScale()), 0.58, 1.0);
}

bool p010BoundedNormalProSdrExport() {
    int signalFamily = int(uniforms.signalFamily + 0.5);
    int activeTransport = int(uniforms.activeTransport + 0.5);
    return signalFamily == SIGNAL_FAMILY_SDR &&
        (activeTransport == ACTIVE_TRANSPORT_REC709_SDR ||
            activeTransport == ACTIVE_TRANSPORT_BT2020_SDR);
}

float p010StrictNormalProSdrExportAuthority() {
    return p010BoundedNormalProSdrExport() ? 1.0 : 0.0;
}

bool p010ZeroVisibleGrainExport() {
    return uniforms.temporalLumaBlend >= 0.99 &&
        uniforms.temporalChromaBlend >= 0.99;
}

float p010StrictVisibleCleanExportAuthority() {
    int signalFamily = int(uniforms.signalFamily + 0.5);
    bool strictEncodedSignal =
        signalFamily == SIGNAL_FAMILY_HDR ||
        signalFamily == SIGNAL_FAMILY_LOG ||
        signalFamily == SIGNAL_FAMILY_RAW;
    bool strictVisibleCleanProfile = strictEncodedSignal &&
        p010ZeroVisibleGrainExport() &&
        uniforms.spatialDenoise >= 0.98 &&
        uniforms.chromaDenoise >= 0.99 &&
        uniforms.sharpening >= 0.90 &&
        uniforms.noiseMetric >= 0.70 &&
        uniforms.aliasSafeMaxDetailDelta <= 0.2201;
    return p010BoundedNormalProSdrExport()
        ? 1.0
        : (strictVisibleCleanProfile ? 10.0 : 1.0);
}

float p010ExportStrictCeiling() {
    return p010BoundedNormalProSdrExport()
        ? 1.0
        : (p010StrictVisibleCleanExportAuthority() > 1.0 ? 10.0 : 1.0);
}

float p010ExportNoiseShape() {
    return p010BoundedNormalProSdrExport()
        ? p010NormalizeStrength(uniforms.noiseMetric)
        : clamp(uniforms.noiseMetric / p010ExportStrictCeiling(), 0.0, 1.0);
}

float p010ExportLocalChromaSpikeShape() {
    return p010BoundedNormalProSdrExport()
        ? p010NormalizeStrength(uniforms.localChromaSpikeSmoothing)
        : clamp(uniforms.localChromaSpikeSmoothing / p010ExportStrictCeiling(), 0.0, 1.0);
}

float p010StrictTexturelessGrainGate(float sampleValue, float localRange, float singlePixelNoise) {
    bool strictQuality = p010BoundedNormalProSdrExport() ||
        p010StrictVisibleCleanExportAuthority() > 1.0;
    if (!strictQuality) return 0.0;
    float flatLumaGate = (1.0 - smoothstep(128.0, 560.0, sampleValue)) *
        (1.0 - smoothstep(42.0, 210.0, localRange));
    float noiseGate = smoothstep(2.0, 34.0, singlePixelNoise);
    return clamp(flatLumaGate * noiseGate, 0.0, 1.0);
}

uint applyTemporalDenoise(uint sampleIndex, uint currentValue, bool chromaSample) {
    if (pushData.hasPreviousFrame == 0u) return currentValue;
    uint previousValue = unpackP010(readPreviousP010Sample(sampleIndex));
    uint delta = uint(abs(int(currentValue) - int(previousValue)));
    float variance = heteroscedasticNoiseVariance(float(currentValue) / 1023.0);
    uint adaptiveBoost = uint(clamp(sqrt(variance) * 1023.0 * 1.90, 0.0, 48.0));
    uint threshold = (chromaSample ? 48u : 32u) + adaptiveBoost;
    if (delta > threshold) return currentValue;
    float legacyWeight = chromaSample ? uniforms.temporalChromaBlend : uniforms.temporalLumaBlend;
    if (!p010BoundedNormalProSdrExport()) {
        return blendSample(currentValue, previousValue, clamp(legacyWeight, 0.0, 1.0));
    }
    float weight = p010NormalizeStrength(legacyWeight);
    float temporalCap = chromaSample ? 0.64 : P010_MAX_TEMPORAL_PREVIOUS_WEIGHT;
    return blendSample(currentValue, previousValue, min(weight, temporalCap));
}

bool sameChromaDirection(int a, int b) {
    return (a < 0 && b < 0) || (a > 0 && b > 0);
}

uint chromaSampleIndex(uint chromaWidth, uint row, uint column, uint componentOffset) {
    return pushData.width * pushData.height + (row * chromaWidth + column) * 2u + componentOffset;
}

uint chromaNeighborAverage(
    uint chromaWidth,
    uint chromaHeight,
    uint row,
    uint column,
    uint componentOffset
) {
    uint total = 0u;
    uint count = 0u;
    if (row > 0u) {
        total += unpackP010(readCurrentP010Sample(chromaSampleIndex(chromaWidth, row - 1u, column, componentOffset)));
        count += 1u;
    }
    if (row + 1u < chromaHeight) {
        total += unpackP010(readCurrentP010Sample(chromaSampleIndex(chromaWidth, row + 1u, column, componentOffset)));
        count += 1u;
    }
    if (column > 0u) {
        total += unpackP010(readCurrentP010Sample(chromaSampleIndex(chromaWidth, row, column - 1u, componentOffset)));
        count += 1u;
    }
    if (column + 1u < chromaWidth) {
        total += unpackP010(readCurrentP010Sample(chromaSampleIndex(chromaWidth, row, column + 1u, componentOffset)));
        count += 1u;
    }
    return count == 0u ? 512u : total / count;
}

bool coherentChromaColor(uint chromaValue, uint neighborAverage) {
    int delta = int(chromaValue) - 512;
    int neighborDelta = int(neighborAverage) - 512;
    return abs(delta) >= COHERENT_CHROMA_MIN_DELTA &&
        abs(neighborDelta) >= COHERENT_CHROMA_MIN_DELTA &&
        sameChromaDirection(delta, neighborDelta) &&
        abs(int(chromaValue) - int(neighborAverage)) <= COHERENT_CHROMA_SUPPORT_WINDOW;
}

uint applyChromaDeadband(uint chromaValue, uint neighborAverage) {
    int delta = int(chromaValue) - 512;
    int neighborDelta = int(neighborAverage) - 512;
    int threshold = int(clamp(uniforms.shadowChromaDeadband, 0.0, 1.0) * 1023.0);
    bool strictVisibleCleanExport = p010BoundedNormalProSdrExport() ||
        p010StrictVisibleCleanExportAuthority() > 1.0;
    float retain = clamp(1.0 - uniforms.chromaDenoise, strictVisibleCleanExport ? 0.0005 : 0.002, 1.0);
    if (coherentChromaColor(chromaValue, neighborAverage)) {
        retain = max(retain, COHERENT_CHROMA_RETAIN_FLOOR);
    } else if (strictVisibleCleanExport) {
        float isolatedNeutralGate = smoothstep(8.0, 56.0, abs(float(delta))) *
            (1.0 - smoothstep(40.0, 96.0, abs(float(neighborDelta))));
        retain *= mix(1.0, 0.16, isolatedNeutralGate);
    }
    // Soft deadband: within the threshold band ramp retain smoothly to 0 instead
    // of a hard snap to neutral 512. The hard return printed a visible chroma
    // contour mid-gradient on smooth desaturated skies (audit rank 28); the ramp
    // is C0-continuous into the above-threshold region (smoothstep==1 at threshold).
    if (threshold > 0) {
        retain *= smoothstep(0.0, float(threshold), abs(float(delta)));
    }
    // Colour-preserving denoise: blend toward the LOCAL CHROMA AVERAGE (which carries the region's
    // real colour) instead of toward neutral 512. The old `512 + delta*retain` pulled every
    // non-coherent chroma sample to gray as chromaDenoise -> 1 (retain -> 0.0005), desaturating real
    // colour all the way to black-and-white — not just smoothing noise. Blending toward the
    // neighbourhood keeps chroma SIGNAL while still removing chroma NOISE: isolated spikes in neutral
    // surrounds have neighbourAverage ~= 512 so they still neutralize, but real weak/textured colour
    // now survives (retain=1 keeps the sample; retain=0 falls back to the colour-carrying average).
    float denoised = mix(float(neighborAverage), float(chromaValue), retain);
    return uint(clamp(denoised, 0.0, 1023.0));
}

uint applyLocalChromaSpikeSmoothing(uint chromaValue, uint neighborAverage) {
    int delta = int(chromaValue) - 512;
    int neighborDelta = int(neighborAverage) - 512;
    bool strictVisibleCleanExport = p010BoundedNormalProSdrExport() ||
        p010StrictVisibleCleanExportAuthority() > 1.0;
    int spikeThreshold = strictVisibleCleanExport ? 44 : 80;
    int neighborNeutralWindow = strictVisibleCleanExport ? 96 : 72;
    bool isolatedSpike = abs(delta) >= spikeThreshold &&
        abs(int(chromaValue) - int(neighborAverage)) >= spikeThreshold &&
        abs(neighborDelta) <= neighborNeutralWindow;
    if (!isolatedSpike) return chromaValue;
    float smoothingPressure = max(p010ExportNoiseShape(), p010ExportLocalChromaSpikeShape());
    float retained = strictVisibleCleanExport ?
        mix(0.018, 0.004, clamp(smoothingPressure, 0.0, 1.0)) :
        mix(0.060, 0.024, clamp(smoothingPressure, 0.0, 1.0));
    return uint(clamp(512.0 + float(delta) * retained, 0.0, 1023.0));
}

float csfMicroContrastWeight(float lightness, float baseGain) {
    float l = clamp(lightness, 0.0, 1.0);
    return max(baseGain, 0.0) * pow(max(1.0 - l, 0.0), 1.2) * pow(max(l, 0.0), 0.8);
}

uint applyEdgeAwareDetailLift(uint sampleIndex, uint centerValue) {
    uint width = max(pushData.width, 1u);
    uint height = max(pushData.height, 1u);
    uint row = sampleIndex / width;
    uint column = sampleIndex - row * width;
    if (row == 0u || column == 0u || row + 1u >= height || column + 1u >= width) return centerValue;

    uint northWest = unpackP010(readCurrentP010Sample(sampleIndex - width - 1u));
    uint north = unpackP010(readCurrentP010Sample(sampleIndex - width));
    uint northEast = unpackP010(readCurrentP010Sample(sampleIndex - width + 1u));
    uint south = unpackP010(readCurrentP010Sample(sampleIndex + width));
    uint southWest = unpackP010(readCurrentP010Sample(sampleIndex + width - 1u));
    uint southEast = unpackP010(readCurrentP010Sample(sampleIndex + width + 1u));
    uint west = unpackP010(readCurrentP010Sample(sampleIndex - 1u));
    uint east = unpackP010(readCurrentP010Sample(sampleIndex + 1u));
    float c = float(centerValue);
    float nw = float(northWest);
    float n = float(north);
    float ne = float(northEast);
    float s = float(south);
    float sw = float(southWest);
    float se = float(southEast);
    float w = float(west);
    float e = float(east);
    float neighborAverage = (c * 4.40 + (n + s + w + e) * 1.26 + (nw + ne + sw + se) * 0.58) / 11.52;
    float edgeSignal = float(centerValue) - neighborAverage;
    float magnitude = abs(edgeSignal) / 1023.0;
    float gain = 0.0;
    if (magnitude >= uniforms.strongEdgeThreshold) {
        gain = (p010BoundedNormalProSdrExport()
            ? p010NormalizeStrength(uniforms.strongDetailGain)
            : uniforms.strongDetailGain) * abrDetailGainScale();
    } else if (magnitude >= uniforms.mediumEdgeThreshold) {
        gain = (p010BoundedNormalProSdrExport()
            ? p010NormalizeStrength(uniforms.mediumDetailGain)
            : uniforms.mediumDetailGain) * abrDetailGainScale();
    } else if (magnitude >= uniforms.fineTextureThreshold) {
        gain = (p010BoundedNormalProSdrExport()
            ? p010NormalizeStrength(uniforms.fineTextureDetailGain)
            : uniforms.fineTextureDetailGain) * abrDetailGainScale();
    }

    float signalSigma = sqrt(max(magnitude * magnitude - heteroscedasticNoiseVariance(float(centerValue) / 1023.0) * 0.070, 0.000001));
    float shrunkEdgeSignal = bayesianWaveletShrink(edgeSignal / 1023.0, float(centerValue) / 1023.0, signalSigma) * 1023.0;
    float scharrX = (-3.0 * nw + 3.0 * ne) + (-10.0 * w + 10.0 * e) + (-3.0 * sw + 3.0 * se);
    float scharrY = (-3.0 * nw - 10.0 * n - 3.0 * ne) + (3.0 * sw + 10.0 * s + 3.0 * se);
    float scharrMagnitude = length(vec2(scharrX, scharrY)) / 1023.0;
    float localMin = min(min(min(nw, n), min(ne, w)), min(min(e, sw), min(s, se)));
    float localMax = max(max(max(nw, n), max(ne, w)), max(max(e, sw), max(s, se)));
    float localRange = (localMax - localMin) / 1023.0;
    float tangentTexture = min(abs(ne - nw) + abs(se - sw), abs(ne - se) + abs(nw - sw)) / 1023.0;
    float normalTexture = (max(abs(e - w), abs(n - s)) + max(abs(ne - sw), abs(nw - se))) / 1023.0;
    float tangentConfidence = clamp(tangentTexture / max(tangentTexture + normalTexture, 0.00001), 0.0, 1.0);
    float hardEdge = smoothstep(0.16, 0.62, localRange) * smoothstep(0.12, 0.82, scharrMagnitude);
    float anisotropicHaloGuard = clamp(1.0 - hardEdge * (1.0 - tangentConfidence * 0.70), 0.04, 1.0);
    float csfGain = 0.82 + csfMicroContrastWeight(float(centerValue) / 1023.0, 1.0) * 2.36;
    float aliasLimit = p010BoundedNormalProSdrExport()
        ? min(clamp(uniforms.aliasSafeMaxDetailDelta, 0.0, 1.0) * 1023.0, 64.0)
        : clamp(uniforms.aliasSafeMaxDetailDelta, 0.0, 1.0) * 1023.0;
    float lift = clamp(shrunkEdgeSignal * gain * anisotropicHaloGuard * csfGain, -aliasLimit, aliasLimit);
    float overshoot = max(6.20, (localMax - localMin) * 0.22);
    float candidate = clamp(float(centerValue) + lift, localMin - overshoot, localMax + overshoot);
    return uint(clamp(candidate, 0.0, 1023.0));
}

uint applyApexMicroTextureRecover(uint sampleIndex, uint detailedValue) {
    uint width = max(pushData.width, 1u);
    uint height = max(pushData.height, 1u);
    uint row = sampleIndex / width;
    uint column = sampleIndex - row * width;
    if (row < 2u || column < 2u || row + 2u >= height || column + 2u >= width) return detailedValue;

    float c = float(unpackP010(readCurrentP010Sample(sampleIndex)));
    float x1n = float(unpackP010(readCurrentP010Sample(sampleIndex - 1u)));
    float x1p = float(unpackP010(readCurrentP010Sample(sampleIndex + 1u)));
    float y1n = float(unpackP010(readCurrentP010Sample(sampleIndex - width)));
    float y1p = float(unpackP010(readCurrentP010Sample(sampleIndex + width)));
    float d1a = float(unpackP010(readCurrentP010Sample(sampleIndex - width - 1u)));
    float d1b = float(unpackP010(readCurrentP010Sample(sampleIndex - width + 1u)));
    float d1c = float(unpackP010(readCurrentP010Sample(sampleIndex + width - 1u)));
    float d1d = float(unpackP010(readCurrentP010Sample(sampleIndex + width + 1u)));
    float x2n = float(unpackP010(readCurrentP010Sample(sampleIndex - 2u)));
    float x2p = float(unpackP010(readCurrentP010Sample(sampleIndex + 2u)));
    float y2n = float(unpackP010(readCurrentP010Sample(sampleIndex - width * 2u)));
    float y2p = float(unpackP010(readCurrentP010Sample(sampleIndex + width * 2u)));

    float axial1 = x1n + x1p + y1n + y1p;
    float diag1 = d1a + d1b + d1c + d1d;
    float axial2 = x2n + x2p + y2n + y2p;
    float microLowPass = (c * 4.0 + axial1 * 1.0 + diag1 * 0.66 + axial2 * 0.36) / 12.08;
    float microTexture = c - microLowPass;
    float localMin = min(min(min(x1n, x1p), min(y1n, y1p)), min(min(d1a, d1b), min(d1c, d1d)));
    localMin = min(localMin, min(min(x2n, x2p), min(y2n, y2p)));
    float localMax = max(max(max(x1n, x1p), max(y1n, y1p)), max(max(d1a, d1b), max(d1c, d1d)));
    localMax = max(localMax, max(max(x2n, x2p), max(y2n, y2p)));
    float localRange = max(localMax - localMin, 1.0);
    float textureGate = smoothstep(uniforms.fineTextureThreshold * 1023.0, uniforms.mediumEdgeThreshold * 2046.0, abs(microTexture));
    float shadowGate = smoothstep(10.0, 64.0, c);
    float highlightGuard = 1.0 - smoothstep(920.0, 1006.0, c);
    bool strictNormalProSdrExport = p010BoundedNormalProSdrExport();
    float profileLift = strictNormalProSdrExport
        ? p010NormalizeStrength(uniforms.fineTextureDetailGain) * abrDetailGainScale()
        : clamp(uniforms.fineTextureDetailGain * abrDetailGainScale() / 10.0, 0.0, 1.0);
    // Strict visible-clean HDR/LOG/RAW export gets the intended EXTRA micro-texture
    // authority. The gate was p010StrictNormalProSdrExportAuthority() which only ever
    // returns 0.0/1.0, so the > 1.0 boost was permanently DEAD — HDR/NIVUKX exports
    // silently missed their intended detail recovery (audit rank 18). Enable it via
    // the correct p010StrictVisibleCleanExportAuthority(), but CONSERVATIVELY: a
    // modest gain boost and a bounded limit (NOT 10x of localRange, which the audit
    // warned would overshoot/ring).
    bool strictVisibleCleanExport = p010StrictVisibleCleanExportAuthority() > 1.0;
    float microGain = strictNormalProSdrExport
        ? mix(1.20, 2.60, profileLift)
        : mix(2.0, 10.0, profileLift) *
            (strictVisibleCleanExport ? 1.5 : 1.0);
    float microLimit = strictNormalProSdrExport
        ? max(3.0, localRange * mix(0.16, 0.28, profileLift))
        : max(3.0, localRange * (strictVisibleCleanExport ? mix(0.30, 0.55, profileLift) : mix(0.18, 0.42, profileLift)));
    float limitedMicro = clamp(
        microTexture * microGain * textureGate * shadowGate * highlightGuard,
        -microLimit,
        microLimit
    );
    float candidate = clamp(float(detailedValue) + limitedMicro, 0.0, 1023.0);
    return uint(candidate);
}

uint applyApexLocalContrastLuma(uint sampleIndex, uint microValue) {
    uint width = max(pushData.width, 1u);
    uint height = max(pushData.height, 1u);
    uint row = sampleIndex / width;
    uint column = sampleIndex - row * width;
    if (row == 0u || column == 0u || row + 1u >= height || column + 1u >= width) return microValue;

    float c = float(unpackP010(readCurrentP010Sample(sampleIndex)));
    float n = float(unpackP010(readCurrentP010Sample(sampleIndex - width)));
    float s = float(unpackP010(readCurrentP010Sample(sampleIndex + width)));
    float w = float(unpackP010(readCurrentP010Sample(sampleIndex - 1u)));
    float e = float(unpackP010(readCurrentP010Sample(sampleIndex + 1u)));
    float nw = float(unpackP010(readCurrentP010Sample(sampleIndex - width - 1u)));
    float ne = float(unpackP010(readCurrentP010Sample(sampleIndex - width + 1u)));
    float sw = float(unpackP010(readCurrentP010Sample(sampleIndex + width - 1u)));
    float se = float(unpackP010(readCurrentP010Sample(sampleIndex + width + 1u)));

    float localMean = (c * 4.0 + (n + s + w + e) * 1.5 + (nw + ne + sw + se) * 0.75) / 13.0;
    float localContrast = c - localMean;
    float localMin = min(min(min(nw, n), min(ne, w)), min(min(e, sw), min(s, se)));
    float localMax = max(max(max(nw, n), max(ne, w)), max(max(e, sw), max(s, se)));
    float localRange = max(localMax - localMin, 1.0);
    float textureGate = smoothstep(4.0, 36.0, abs(localContrast)) * smoothstep(8.0, 96.0, localRange);
    float shadowGate = smoothstep(12.0, 80.0, c);
    float highlightGuard = 1.0 - smoothstep(900.0, 1010.0, c);
    bool strictNormalProSdrExport = p010BoundedNormalProSdrExport();
    float profileLift = strictNormalProSdrExport
        ? p010NormalizeStrength(uniforms.strongDetailGain) * abrDetailGainScale()
        : clamp(uniforms.strongDetailGain * abrDetailGainScale() / 10.0, 0.0, 1.0);
    float contrastGain = strictNormalProSdrExport
        ? 1.0 + 0.45 * profileLift
        : 1.0 + 3.0 * profileLift;
    float contrastLimit = strictNormalProSdrExport
        ? max(3.0, localRange * 0.24)
        : max(3.0, localRange * 0.16);
    float limitedContrast = clamp(
        localContrast * contrastGain * textureGate * shadowGate * highlightGuard,
        -contrastLimit,
        contrastLimit
    );
    float candidate = clamp(float(microValue) + limitedContrast, 0.0, 1023.0);
    return uint(candidate);
}

uint applyApexShadowNoiseFloorLuma(uint sampleIndex, uint contrastValue) {
    uint width = max(pushData.width, 1u);
    uint height = max(pushData.height, 1u);
    uint row = sampleIndex / width;
    uint column = sampleIndex - row * width;
    if (row == 0u || column == 0u || row + 1u >= height || column + 1u >= width) return contrastValue;

    float c = float(unpackP010(readCurrentP010Sample(sampleIndex)));
    float n = float(unpackP010(readCurrentP010Sample(sampleIndex - width)));
    float s = float(unpackP010(readCurrentP010Sample(sampleIndex + width)));
    float w = float(unpackP010(readCurrentP010Sample(sampleIndex - 1u)));
    float e = float(unpackP010(readCurrentP010Sample(sampleIndex + 1u)));
    float nw = float(unpackP010(readCurrentP010Sample(sampleIndex - width - 1u)));
    float ne = float(unpackP010(readCurrentP010Sample(sampleIndex - width + 1u)));
    float sw = float(unpackP010(readCurrentP010Sample(sampleIndex + width - 1u)));
    float se = float(unpackP010(readCurrentP010Sample(sampleIndex + width + 1u)));

    float localMean = (c * 4.0 + (n + s + w + e) * 1.5 + (nw + ne + sw + se) * 0.75) / 13.0;
    float localMin = min(min(min(nw, n), min(ne, w)), min(min(e, sw), min(s, se)));
    float localMax = max(max(max(nw, n), max(ne, w)), max(max(e, sw), max(s, se)));
    float localRange = max(localMax - localMin, 1.0);
    bool strictVisibleCleanExport = p010BoundedNormalProSdrExport() ||
        p010StrictVisibleCleanExportAuthority() > 1.0;
    float legacyShadowNoiseGate = (1.0 - smoothstep(96.0, 360.0, c)) *
        (1.0 - smoothstep(80.0, 260.0, localRange));
    float strictShadowNoiseGate = max(
        (1.0 - smoothstep(128.0, 520.0, c)) *
            (1.0 - smoothstep(96.0, 340.0, localRange)),
        p010StrictTexturelessGrainGate(c, localRange, abs(c - localMean))
    );
    float shadowNoiseGate = strictVisibleCleanExport ? strictShadowNoiseGate : legacyShadowNoiseGate;
    float noiseFloorWeight = strictVisibleCleanExport ? 1.0 :
        clamp(p010ExportNoiseShape() * 0.50, 0.0, 1.0);
    noiseFloorWeight *= shadowNoiseGate;
    float candidate = mix(float(contrastValue), localMean, noiseFloorWeight);
    return uint(clamp(candidate, 0.0, 1023.0));
}

uint applyApexHighlightTextureLuma(uint sampleIndex, uint shadowCleanValue) {
    uint width = max(pushData.width, 1u);
    uint height = max(pushData.height, 1u);
    uint row = sampleIndex / width;
    uint column = sampleIndex - row * width;
    if (row == 0u || column == 0u || row + 1u >= height || column + 1u >= width) return shadowCleanValue;

    float c = float(unpackP010(readCurrentP010Sample(sampleIndex)));
    float n = float(unpackP010(readCurrentP010Sample(sampleIndex - width)));
    float s = float(unpackP010(readCurrentP010Sample(sampleIndex + width)));
    float w = float(unpackP010(readCurrentP010Sample(sampleIndex - 1u)));
    float e = float(unpackP010(readCurrentP010Sample(sampleIndex + 1u)));
    float nw = float(unpackP010(readCurrentP010Sample(sampleIndex - width - 1u)));
    float ne = float(unpackP010(readCurrentP010Sample(sampleIndex - width + 1u)));
    float sw = float(unpackP010(readCurrentP010Sample(sampleIndex + width - 1u)));
    float se = float(unpackP010(readCurrentP010Sample(sampleIndex + width + 1u)));

    float localMean = (c * 4.0 + (n + s + w + e) * 1.5 + (nw + ne + sw + se) * 0.75) / 13.0;
    float highlightDetail = c - localMean;
    float localMin = min(min(min(nw, n), min(ne, w)), min(min(e, sw), min(s, se)));
    float localMax = max(max(max(nw, n), max(ne, w)), max(max(e, sw), max(s, se)));
    float localRange = max(localMax - localMin, 1.0);
    float highlightTextureGate = smoothstep(600.0, 880.0, c) *
        (1.0 - smoothstep(980.0, 1023.0, c));
    float textureGate = smoothstep(4.0, 32.0, abs(highlightDetail)) *
        smoothstep(10.0, 96.0, localRange);
    bool strictNormalProSdrExport = p010BoundedNormalProSdrExport();
    float profileLift = strictNormalProSdrExport
        ? p010NormalizeStrength(uniforms.mediumDetailGain) * abrDetailGainScale()
        : clamp(uniforms.mediumDetailGain * abrDetailGainScale() / 10.0, 0.0, 1.0);
    float highlightGain = strictNormalProSdrExport
        ? 1.0 + 0.55 * profileLift
        : 1.0 + 4.0 * profileLift;
    float highlightLimit = strictNormalProSdrExport
        ? max(4.0, localRange * 0.24)
        : max(4.0, localRange * 0.18);
    float headroomGuard = highlightDetail > 0.0 ?
        smoothstep(0.0, 32.0, 1023.0 - float(shadowCleanValue)) : 1.0;
    float limitedHighlight = clamp(
        highlightDetail * highlightGain * highlightTextureGate * textureGate * headroomGuard,
        -highlightLimit,
        highlightLimit
    );
    float candidate = clamp(float(shadowCleanValue) + limitedHighlight, 0.0, 1023.0);
    return uint(candidate);
}

uint applyApexEdgeCoherenceLuma(uint sampleIndex, uint highlightedValue) {
    uint width = max(pushData.width, 1u);
    uint height = max(pushData.height, 1u);
    uint row = sampleIndex / width;
    uint column = sampleIndex - row * width;
    if (row == 0u || column == 0u || row + 1u >= height || column + 1u >= width) return highlightedValue;

    float c = float(unpackP010(readCurrentP010Sample(sampleIndex)));
    float n = float(unpackP010(readCurrentP010Sample(sampleIndex - width)));
    float s = float(unpackP010(readCurrentP010Sample(sampleIndex + width)));
    float w = float(unpackP010(readCurrentP010Sample(sampleIndex - 1u)));
    float e = float(unpackP010(readCurrentP010Sample(sampleIndex + 1u)));
    float nw = float(unpackP010(readCurrentP010Sample(sampleIndex - width - 1u)));
    float ne = float(unpackP010(readCurrentP010Sample(sampleIndex - width + 1u)));
    float sw = float(unpackP010(readCurrentP010Sample(sampleIndex + width - 1u)));
    float se = float(unpackP010(readCurrentP010Sample(sampleIndex + width + 1u)));

    float localMean = (c * 4.0 + (n + s + w + e) * 1.5 + (nw + ne + sw + se) * 0.75) / 13.0;
    float gx = (e - w) + (ne + se - nw - sw) * 0.5;
    float gy = (s - n) + (sw + se - nw - ne) * 0.5;
    float localMin = min(c, min(min(min(nw, n), min(ne, w)), min(min(e, sw), min(s, se))));
    float localMax = max(c, max(max(max(nw, n), max(ne, w)), max(max(e, sw), max(s, se))));
    float localRange = max(localMax - localMin, 1.0);
    float detail = c - localMean;
    float edgeCoherenceGate = smoothstep(18.0, 96.0, abs(gx) + abs(gy)) *
        smoothstep(10.0, 96.0, localRange);
    float haloRisk = smoothstep(localRange * 0.52, localRange, abs(detail));
    bool strictNormalProSdrExport = p010BoundedNormalProSdrExport();
    float profileLift = strictNormalProSdrExport
        ? p010NormalizeStrength(uniforms.strongDetailGain) * abrDetailGainScale()
        : clamp(uniforms.strongDetailGain * abrDetailGainScale() / 10.0, 0.0, 1.0);
    float edgeGain = strictNormalProSdrExport
        ? 1.0 + 0.60 * profileLift
        : 1.0 + 4.0 * profileLift;
    float edgeLimit = strictNormalProSdrExport
        ? max(4.0, localRange * 0.26)
        : max(4.0, localRange * 0.20);
    float coherentLift = clamp(
        detail * edgeGain * edgeCoherenceGate * (1.0 - haloRisk * 0.48),
        -edgeLimit,
        edgeLimit
    );
    float candidate = float(highlightedValue) + coherentLift;
    float haloSafe = clamp(candidate, max(localMin - edgeLimit, 0.0), min(localMax + edgeLimit, 1023.0));
    return uint(clamp(haloSafe, 0.0, 1023.0));
}

uint applyApexTonalDensityLuma(uint sampleIndex, uint edgeValue) {
    uint width = max(pushData.width, 1u);
    uint height = max(pushData.height, 1u);
    uint row = sampleIndex / width;
    uint column = sampleIndex - row * width;
    if (row == 0u || column == 0u || row + 1u >= height || column + 1u >= width) return edgeValue;

    float c = float(unpackP010(readCurrentP010Sample(sampleIndex)));
    float n = float(unpackP010(readCurrentP010Sample(sampleIndex - width)));
    float s = float(unpackP010(readCurrentP010Sample(sampleIndex + width)));
    float w = float(unpackP010(readCurrentP010Sample(sampleIndex - 1u)));
    float e = float(unpackP010(readCurrentP010Sample(sampleIndex + 1u)));
    float nw = float(unpackP010(readCurrentP010Sample(sampleIndex - width - 1u)));
    float ne = float(unpackP010(readCurrentP010Sample(sampleIndex - width + 1u)));
    float sw = float(unpackP010(readCurrentP010Sample(sampleIndex + width - 1u)));
    float se = float(unpackP010(readCurrentP010Sample(sampleIndex + width + 1u)));

    float localMin = min(c, min(min(min(nw, n), min(ne, w)), min(min(e, sw), min(s, se))));
    float localMax = max(c, max(max(max(nw, n), max(ne, w)), max(max(e, sw), max(s, se))));
    float localRange = max(localMax - localMin, 1.0);
    float neighborMean = (n + s + w + e + nw + ne + sw + se) * 0.125;
    float isolatedBrightDetail = max(c - neighborMean, 0.0);
    float isolatedDetailGuard = 1.0 - smoothstep(6.0, 18.0, isolatedBrightDetail);
    float midtoneGate = smoothstep(160.0, 360.0, c) *
        (1.0 - smoothstep(760.0, 980.0, c));
    float flatMidtoneGate = (1.0 - smoothstep(96.0, 260.0, localRange)) *
        midtoneGate;
    bool strictNormalProSdrExport = p010BoundedNormalProSdrExport();
    float profileLift = strictNormalProSdrExport
        ? p010NormalizeStrength(uniforms.mediumDetailGain) * abrDetailGainScale()
        : clamp(uniforms.mediumDetailGain * abrDetailGainScale() / 10.0, 0.0, 1.0);
    float normalized = clamp((float(edgeValue) - 512.0) / 512.0, -1.0, 1.0);
    float densityGain = strictNormalProSdrExport
        ? 1.0 + 0.35 * profileLift
        : 1.0 + 3.0 * profileLift;
    float densityDelta = normalized * (1.0 - abs(normalized)) * densityGain;
    float positiveDensityGuard = densityDelta > 0.0 ? isolatedDetailGuard : 1.0;
    float densityLimit = strictNormalProSdrExport
        ? max(2.0, localRange * 0.10)
        : max(2.0, localRange * 0.06);
    float candidate = float(edgeValue) + densityDelta * flatMidtoneGate * positiveDensityGuard * 24.0;
    float densitySafe = clamp(candidate, float(edgeValue) - densityLimit, float(edgeValue) + densityLimit);
    return uint(clamp(densitySafe, 0.0, 1023.0));
}

uint applyApexLongDistanceDetailLuma(uint sampleIndex, uint tonalValue) {
    uint width = max(pushData.width, 1u);
    uint height = max(pushData.height, 1u);
    uint row = sampleIndex / width;
    uint column = sampleIndex - row * width;
    if (row < 2u || column < 2u || row + 2u >= height || column + 2u >= width) return tonalValue;

    float c = float(unpackP010(readCurrentP010Sample(sampleIndex)));
    float x1n = float(unpackP010(readCurrentP010Sample(sampleIndex - 1u)));
    float x1p = float(unpackP010(readCurrentP010Sample(sampleIndex + 1u)));
    float y1n = float(unpackP010(readCurrentP010Sample(sampleIndex - width)));
    float y1p = float(unpackP010(readCurrentP010Sample(sampleIndex + width)));
    float d1a = float(unpackP010(readCurrentP010Sample(sampleIndex - width - 1u)));
    float d1b = float(unpackP010(readCurrentP010Sample(sampleIndex - width + 1u)));
    float d1c = float(unpackP010(readCurrentP010Sample(sampleIndex + width - 1u)));
    float d1d = float(unpackP010(readCurrentP010Sample(sampleIndex + width + 1u)));
    float x2n = float(unpackP010(readCurrentP010Sample(sampleIndex - 2u)));
    float x2p = float(unpackP010(readCurrentP010Sample(sampleIndex + 2u)));
    float y2n = float(unpackP010(readCurrentP010Sample(sampleIndex - width * 2u)));
    float y2p = float(unpackP010(readCurrentP010Sample(sampleIndex + width * 2u)));
    bool hasWideRing = row >= 3u && column >= 3u && row + 3u < height && column + 3u < width;
    float x3n = x2n;
    float x3p = x2p;
    float y3n = y2n;
    float y3p = y2p;
    if (hasWideRing) {
        x3n = float(unpackP010(readCurrentP010Sample(sampleIndex - 3u)));
        x3p = float(unpackP010(readCurrentP010Sample(sampleIndex + 3u)));
        y3n = float(unpackP010(readCurrentP010Sample(sampleIndex - width * 3u)));
        y3p = float(unpackP010(readCurrentP010Sample(sampleIndex + width * 3u)));
    }

    float axial1 = x1n + x1p + y1n + y1p;
    float diagonal1 = d1a + d1b + d1c + d1d;
    float axial2 = x2n + x2p + y2n + y2p;
    float axial3 = x3n + x3p + y3n + y3p;
    float nearMean = (c * 4.0 + axial1 * 1.0 + diagonal1 * 0.75) / 11.0;
    float farMean = (c * 4.0 + axial1 * 1.0 + diagonal1 * 0.66 + axial2 * 0.50) / 12.64;
    float longDistanceDetail = (c - farMean) + (nearMean - farMean);
    float wideMean = hasWideRing ?
        (c * 4.0 + axial1 * 0.82 + diagonal1 * 0.56 + axial2 * 0.44 + axial3 * 0.30) / 13.92 :
        farMean;
    float longDistanceStructure = mix(
        longDistanceDetail,
        (c - wideMean) + (nearMean - wideMean),
        hasWideRing ? 0.42 : 0.18
    );
    float singlePixelNoise = abs(c - nearMean);
    float localMin = min(min(min(c, x1n), min(x1p, y1n)), min(min(y1p, d1a), min(d1b, d1c)));
    localMin = min(localMin, min(min(d1d, x2n), min(x2p, min(y2n, y2p))));
    localMin = min(localMin, min(min(x3n, x3p), min(y3n, y3p)));
    float localMax = max(max(max(c, x1n), max(x1p, y1n)), max(max(y1p, d1a), max(d1b, d1c)));
    localMax = max(localMax, max(max(d1d, x2n), max(x2p, max(y2n, y2p))));
    localMax = max(localMax, max(max(x3n, x3p), max(y3n, y3p)));
    float localRange = max(localMax - localMin, 1.0);
    float textureGate = smoothstep(0.35, 2.2, abs(longDistanceStructure)) *
        (1.0 - smoothstep(56.0, 144.0, localRange));
    float midtoneGate = smoothstep(64.0, 180.0, c) *
        (1.0 - smoothstep(900.0, 1016.0, c));
    float wideAgreement = hasWideRing ?
        1.0 - smoothstep(2.0, 18.0, abs(farMean - wideMean)) :
        0.38;
    float noiseReject = clamp(
        1.0 - smoothstep(18.0, 42.0, singlePixelNoise) * (0.62 - wideAgreement * 0.22),
        0.34 + wideAgreement * 0.24,
        1.0
    );
    bool strictNormalProSdrExport = p010BoundedNormalProSdrExport();
    float profileLift = strictNormalProSdrExport
        ? p010NormalizeStrength(uniforms.fineTextureDetailGain) * abrDetailGainScale()
        : clamp(uniforms.fineTextureDetailGain * abrDetailGainScale() / 10.0, 0.0, 1.0);
    if (!strictNormalProSdrExport) return tonalValue;
    float longDistanceGain = strictNormalProSdrExport
        ? 1.0 + 1.40 * profileLift
        : 1.0 + 4.0 * profileLift;
    float detailLimit = strictNormalProSdrExport
        ? max(2.0, localRange * 0.18)
        : max(2.0, localRange * 0.10);
    float current = float(tonalValue);
    float detailLift = clamp(
        longDistanceStructure * longDistanceGain * textureGate * midtoneGate * noiseReject,
        -detailLimit,
        detailLimit
    );
    float candidate = current + detailLift;
    float safeDetail = clamp(candidate, max(localMin - detailLimit, current - detailLimit), min(min(localMax + detailLimit, current + detailLimit), 1023.0));
    return uint(clamp(safeDetail, 0.0, 1023.0));
}

float p010DetailNoiseConfidence(uint sampleIndex, float baseValue, float localMean, float localRange) {
    float residual = abs(baseValue - localMean);
    float expectedNoise = sqrt(heteroscedasticNoiseVariance(baseValue / 1023.0)) * 1023.0;
    float residualConfidence = smoothstep(expectedNoise * 1.35, expectedNoise * 4.5, residual);
    float rangeConfidence = smoothstep(expectedNoise * 2.0, expectedNoise * 8.0, localRange);
    return clamp(max(residualConfidence, rangeConfidence * 0.72) * (1.0 - p010ExportNoiseShape() * 0.52), 0.0, 1.0);
}

float p010SkinDetailGuard(float lumaCode) {
    float normalizedLuma = clamp(lumaCode / 1023.0, 0.0, 1.0);
    float skinExposureWindow = smoothstep(0.08, 0.24, normalizedLuma) *
        (1.0 - smoothstep(0.72, 0.94, normalizedLuma));
    float protection = p010NormalizeStrength(uniforms.skinDetailProtection);
    return mix(1.0, 0.68, skinExposureWindow * protection);
}

uint applyCumulativeDetailBudget(uint sampleIndex, uint detailBase, uint candidateValue) {
    uint width = max(pushData.width, 1u);
    uint height = max(pushData.height, 1u);
    uint row = sampleIndex / width;
    uint column = sampleIndex - row * width;
    if (row == 0u || column == 0u || row + 1u >= height || column + 1u >= width) {
        return detailBase;
    }

    float n = float(unpackP010(readCurrentP010Sample(sampleIndex - width)));
    float s = float(unpackP010(readCurrentP010Sample(sampleIndex + width)));
    float w = float(unpackP010(readCurrentP010Sample(sampleIndex - 1u)));
    float e = float(unpackP010(readCurrentP010Sample(sampleIndex + 1u)));
    float nw = float(unpackP010(readCurrentP010Sample(sampleIndex - width - 1u)));
    float ne = float(unpackP010(readCurrentP010Sample(sampleIndex - width + 1u)));
    float sw = float(unpackP010(readCurrentP010Sample(sampleIndex + width - 1u)));
    float se = float(unpackP010(readCurrentP010Sample(sampleIndex + width + 1u)));
    float baseValue = float(detailBase);
    float candidate = float(candidateValue);
    float localMin = min(baseValue, min(min(min(nw, n), min(ne, w)), min(min(e, sw), min(s, se))));
    float localMax = max(baseValue, max(max(max(nw, n), max(ne, w)), max(max(e, sw), max(s, se))));
    float localRange = max(localMax - localMin, 1.0);
    float localMean = (n + s + w + e + nw + ne + sw + se) * 0.125;

    float noiseConfidence = p010DetailNoiseConfidence(sampleIndex, baseValue, localMean, localRange);
    float edgeGuard = mix(1.0, 0.62, smoothstep(164.0, 532.0, localRange));
    float highlightGuard = 1.0 - smoothstep(736.0, 1006.0, baseValue) * 0.76;
    float skinGuard = p010SkinDetailGuard(baseValue);
    float requestedDelta = candidate - baseValue;
    float haloGuard = 1.0 - smoothstep(localRange * 0.42, localRange, abs(requestedDelta)) * 0.80;
    float detailBudget = min(
        P010_MAX_CUMULATIVE_DETAIL_CODES,
        max(3.0, localRange * 0.20)
    ) * noiseConfidence * edgeGuard * highlightGuard * skinGuard * haloGuard;
    float boundedDelta = clamp(requestedDelta, -detailBudget, detailBudget);
    float cumulativeOvershoot = min(6.0, max(1.5, localRange * 0.08));
    float bounded = clamp(
        baseValue + boundedDelta,
        max(0.0, localMin - cumulativeOvershoot),
        min(1023.0, localMax + cumulativeOvershoot)
    );
    return uint(clamp(bounded + 0.5, 0.0, 1023.0));
}

