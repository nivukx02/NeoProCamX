vec3 nivukxApexSignalShape(vec3 lab, float sceneLux, float kelvin) {
    float chroma = length(lab.yz);
    if (chroma <= 1e-6) return vec3(max(lab.x, 0.0), 0.0, 0.0);
    float hue = atan(lab.z, lab.y);
    float highlight = smoothstep(0.56, 1.06, lab.x);
    float deepShadow = 1.0 - smoothstep(0.04, 0.24, lab.x);
    float lowLux = 1.0 - smoothstep(12.0, 900.0, max(sceneLux, 0.0));
    float kelvinBias = clamp((6500.0 - clamp(kelvin, 1800.0, 12000.0)) / 6500.0, -0.45, 0.45);
    float chromaScale = clamp(1.0 - highlight * 0.42 - deepShadow * lowLux * 0.10 + kelvinBias * 0.035, 0.16, 1.04);
    float shapedChroma = chroma * chromaScale;
    return vec3(max(lab.x + deepShadow * lowLux * 0.018, 0.0), cos(hue) * shapedChroma, sin(hue) * shapedChroma);
}

float ndr10RationalBezierToneMap(float x, float sceneMin, float sceneMax) {
    float safeMin = max(sceneMin, 0.0001);
    float safeMax = max(sceneMax, safeMin + 0.0001);
    float contrastRatio = clamp(safeMax / safeMin, 1.0, 100000.0);
    float highDynamicRange = smoothstep(80.0, 8000.0, contrastRatio);
    float lowLight = 1.0 - smoothstep(0.24, 1.20, safeMax);
    float alpha = clamp(0.16 + highDynamicRange * 0.68, 0.16, 0.84);
    float beta = clamp(0.20 + lowLight * 0.58, 0.20, 0.78);
    float gamma = clamp(0.12 + highDynamicRange * 0.34, 0.12, 0.46);
    float normalized = clamp(x / max(safeMax, 1.0), 0.0, 1.0);
    float denominator = normalized + beta * max(1.0 - gamma * normalized, 0.05);
    return clamp(normalized * (1.0 + alpha * normalized) / max(denominator, 1e-6), 0.0, 1.0);
}

vec3 applySubtractiveFilmDensity(vec3 rgb) {
    float saturation = max(max(rgb.r, rgb.g), rgb.b) - min(min(rgb.r, rgb.g), rgb.b);
    vec3 kappa = vec3(0.34, 0.30, 0.26);
    return max(rgb * exp(-kappa * (vec3(1.0) - clamp(rgb, 0.0, 1.0)) * saturation), vec3(0.0));
}

vec3 highlightSaturationRolloff(vec3 rgb) {
    float peak = max(max(rgb.r, rgb.g), rgb.b);
    float rolloff = smoothstep(0.78, 1.0, peak);
    float y = dot(rgb, vec3(0.2627, 0.6780, 0.0593));
    return mix(rgb, vec3(y), rolloff);
}

float neoHighEndKneeCurve(float luma, float knee, float shoulder, float strength) {
    float x = max(luma, 0.0);
    float safeKnee = clamp(knee, 0.18, 0.92);
    float safeShoulder = clamp(shoulder, safeKnee + 0.02, 1.0);
    float safeStrength = max(strength, 0.05);
    if (x <= safeKnee) return x;

    float span = max(safeShoulder - safeKnee, 1e-5);
    float normalized = max((x - safeKnee) / span, 0.0);
    // C1 Reinhard highlight shoulder: unit slope at the knee join (no contrast
    // kick / Mach band), monotone, and COMPRESSING (output <= input). The prior
    // tanh(strength*n)/tanh(strength) had slope strength/tanh(strength) (~2.3) at
    // the knee and EXPANDED upper-midtones (output exceeded input — audit rank 3).
    // Gentle rolloff maps the shoulder just below itself into highlight headroom.
    float kneeShoulderA = clamp((safeStrength - 1.0) * 0.14, 0.02, 0.35);
    float normalizedMapped = normalized / (1.0 + kneeShoulderA * normalized);
    return clamp(safeKnee + span * normalizedMapped, 0.0, safeShoulder);
}

vec4 resolveNeoHighEndKneeParams(bool nivukxVision, bool ndr10Plus, float highlightCompression) {
    vec4 params = vec4(0.72, 1.00, 1.36, 0.42);
    if (nivukxVision) {
        params = vec4(0.54, 1.00, 2.25, 1.00);
    } else if (ndr10Plus) {
        params = vec4(0.58, 1.00, 2.05, 1.00);
    }

    float userCompression = clamp(highlightCompression, 0.0, 1.0);
    params.x = clamp(params.x - userCompression * mix(0.035, 0.085, params.w), 0.42, 0.78);
    params.z = clamp(params.z + userCompression * mix(0.28, 0.72, params.w), 1.12, 2.90);
    return params;
}

uint applyNeoHighEndKneeCurveToLuma(uint sampleValue, vec4 kneeParams) {
    float sourceY = float(sampleValue) / 1023.0;
    float mappedY = neoHighEndKneeCurve(sourceY, kneeParams.x, kneeParams.y, kneeParams.z);
    return uint(clamp(mappedY * 1023.0 + 0.5, 0.0, 1023.0));
}

vec3 encodeNLogV3Family(vec3 linear, float e, float a, float b, float d, float f) {
    float c = a * (d * e + f) / d;
    float g = a * e + b - c * log(d * e + f);
    vec3 x = clamp(linear, 0.0, 1.0);
    vec3 linearPart = a * x + vec3(b);
    vec3 logPart = c * log(d * x + vec3(f)) + vec3(g);
    return clamp(mix(logPart, linearPart, lessThan(x, vec3(e))), 0.0, 1.0);
}

vec3 applyEliteCinemaColorPipeline(vec3 rgb, bool nivukxVision, bool ndr10Plus, float sceneMin, float sceneMax) {
    vec3 source = max(rgb, vec3(0.0));
    vec3 mapped = max(XYZ_TO_NEO_WIDE_GAMUT * neoWideGamutCompressXyPreserveY(NEO_WIDE_GAMUT_TO_XYZ * source), vec3(0.0));
    if (ndr10Plus) {
        float y = max(dot(mapped, vec3(0.2627, 0.6780, 0.0593)), 1e-5);
        mapped *= max(ndr10RationalBezierToneMap(y, sceneMin, sceneMax), 1e-5) / y;
    }
    if (nivukxVision) {
        vec3 lab = hpeXyzToNivukxOklab(NEO_WIDE_GAMUT_TO_XYZ * mapped);
        mapped = max(XYZ_TO_NEO_WIDE_GAMUT * neoWideGamutCompressXyPreserveY(nivukxOklabToHpeXyz(nivukxApexSignalShape(lab, 420.0, 5500.0))), vec3(0.0));
    }
    return clamp(highlightSaturationRolloff(applySubtractiveFilmDensity(mapped)), 0.0, 1.08);
}

float acesHighlightRollOff(float value) {
    float a = mix(0.18, 0.72, clamp(uniforms.highlightCompression, 0.0, 1.0));
    float b = mix(0.015, 0.055, clamp(uniforms.videoHdrFusionStrength, 0.0, 1.0));
    return clamp((value * (1.0 + a * value)) / max(value + b, 0.0001), 0.0, 1.0);
}

uint applyAcesCgRollOff(uint sampleIndex, uint sampleValue) {
    float y = float(sampleValue) / 1023.0;
    vec3 linearNeoWideGamut = vec3(y);
    bool nivukxVision = int(uniforms.colorScience + 0.5) == COLOR_SCIENCE_NIVUKX_VISION;
    bool ndr10Plus = int(uniforms.colorScience + 0.5) == COLOR_SCIENCE_NDR10_PLUS;
    bool neoAcesHighEnd = int(uniforms.colorScience + 0.5) == COLOR_SCIENCE_NEO_ACES_HIGH_END;
    bool neoAcesAp0 = int(uniforms.colorSpace + 0.5) == COLOR_SPACE_NEO_ACES_AP0;
    vec3 elite = applyEliteCinemaColorPipeline(linearNeoWideGamut, nivukxVision, ndr10Plus, 0.0004, 4.0);
    vec3 aces = neoWideGamutToAcesCg(elite);
    if (neoAcesHighEnd) {
        aces = highlightSaturationRolloff(applySubtractiveFilmDensity(aces));
        if (neoAcesAp0) {
            float luma = dot(aces, vec3(0.272229, 0.674082, 0.053689));
            aces = mix(aces, vec3(luma), 0.04);
        }
    }
    float mapped = acesHighlightRollOff(dot(aces, vec3(0.272229, 0.674082, 0.053689)));
    return uint(clamp(mapped * 1023.0 + 0.5, 0.0, 1023.0));
}

uint finalJndBlueNoiseQuantize(uint sampleIndex, uint sampleValue) {
    if (p010ZeroVisibleGrainExport()) return sampleValue;
    float quantizationError = jndShapedQuantizationError(sampleIndex, sampleValue);
    float quantized = float(sampleValue) + (quantizationError >= 0.50 ? 1.0 : (quantizationError <= -0.50 ? -1.0 : 0.0));
    return uint(clamp(quantized, 0.0, 1023.0));
}

// NEW TECHNOLOGY: NIVUKX Quantum-Detail Film Texture Synthesis (QD-FTS)
// Reconstructs premium organic silver-halide texture modeling 15/70mm cinema analog stock on Vulkan
uint applyQuantumDetailFilmTexture(uint sampleIndex, uint sampleValue) {
    // Honor the zero-visible-grain clean-export contract like every other grain
    // stage. Without this guard, NIVUKX_VISION (temporal blends == 1.0) still got
    // ~8.7 codes of content-correlated fixed-pattern film texture stamped on every
    // midtone, defeating the clean-export promise (audit rank 10).
    if (p010ZeroVisibleGrainExport()) return sampleValue;
    uint width = max(pushData.width, 1u);
    uint height = max(pushData.height, 1u);
    uint row = sampleIndex / width;
    uint col = sampleIndex - row * width;
    vec2 uv = vec2(float(col) / float(width), float(row) / float(height));

    float luma = float(sampleValue) / 1023.0;

    uint nextIdx = sampleIndex + 1u < width * height ? sampleIndex + 1u : sampleIndex;
    uint prevIdx = sampleIndex > 0u ? sampleIndex - 1u : sampleIndex;
    float noise1 = float(unpackP010(readCurrentP010Sample(nextIdx))) / 1023.0;
    float noise2 = float(unpackP010(readCurrentP010Sample(prevIdx))) / 1023.0;

    float temporalSeed = fract((luma + noise1) * 12.9898 + (luma - noise2) * 78.233);
    float randomVal = fract(sin(dot(uv.xy * 1.5, vec2(12.9898, 78.233)) + temporalSeed) * 43758.5453);

    float randomCoarse = fract(sin(dot(floor(uv.xy * vec2(1280.0, 720.0)) / vec2(1280.0, 720.0), vec2(12.9898, 78.233)) + temporalSeed * 1.618) * 43758.5453);
    float combinedNoise = mix(randomVal, randomCoarse, 0.40) - 0.5;

    float midtoneWeight = smoothstep(0.04, 0.28, luma) * (1.0 - smoothstep(0.68, 0.92, luma));
    float shadowProtect = smoothstep(0.00, 0.08, luma);
    float specularProtectVal = 1.0 - smoothstep(0.85, 1.0, luma);

    float strength = uniforms.sharpening;
    float textureOffset = combinedNoise * midtoneWeight * shadowProtect * specularProtectVal * 0.0085 * clamp(strength, 0.0, 2.0) * 1023.0;

    return uint(clamp(float(sampleValue) + textureOffset, 0.0, 1023.0));
}

