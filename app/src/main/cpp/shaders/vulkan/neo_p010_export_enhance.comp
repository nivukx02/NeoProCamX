vec2 neuralOpticalFlowVector(uint sampleIndex) {
    uint width = max(pushData.width, 1u);
    uint x = sampleIndex - (sampleIndex / width) * width;
    uint y = sampleIndex / width;
    float gyroPhase = uniforms.dualGainTimestampSkew * 6.2831853;
    float flowX = (sin(float(y) * 0.03125 + gyroPhase) * 0.35 + uniforms.dualGainKGain * 0.18) *
        clamp(uniforms.dualGainMotionMaskEnabled, 0.0, 1.0);
    float flowY = (cos(float(x) * 0.03125 + gyroPhase) * 0.35 + uniforms.dualGainNoiseFloor * 0.12) *
        clamp(uniforms.dualGainMotionMaskEnabled, 0.0, 1.0);
    return vec2(flowX, flowY);
}

uint motionCompensatedPreviousIndex(uint sampleIndex, out float boundaryGuard) {
    uint width = max(pushData.width, 1u);
    uint height = max(pushData.height, 1u);
    uint row = sampleIndex / width;
    uint column = sampleIndex - row * width;
    vec2 flow = neuralOpticalFlowVector(sampleIndex);
    vec2 warped = vec2(float(column), float(row)) - flow;
    boundaryGuard = step(0.0, warped.x) * step(0.0, warped.y) *
        step(warped.x, float(width - 1u)) * step(warped.y, float(height - 1u));
    vec2 clampedWarp = clamp(warped, vec2(0.0), vec2(float(width - 1u), float(height - 1u)));
    uint warpedX = uint(clampedWarp.x + 0.5);
    uint warpedY = uint(clampedWarp.y + 0.5);
    return warpedY * width + warpedX;
}

float p010TemporalMotionConfidence(
    uint currentValue,
    uint previousValue,
    float flowMagnitude,
    bool chromaSample
) {
    float delta = abs(float(currentValue) - float(previousValue));
    float variance = heteroscedasticNoiseVariance(float(currentValue) / 1023.0);
    float noiseCodes = sqrt(variance) * 1023.0;
    float photometricConfidence = 1.0 - smoothstep(
        noiseCodes * (chromaSample ? 2.8 : 2.2),
        noiseCodes * (chromaSample ? 7.0 : 5.5) + 8.0,
        delta
    );
    float flowConfidence = 1.0 - smoothstep(0.35, 2.25, flowMagnitude);
    float timestampConfidence = 1.0 - smoothstep(0.001, 0.012, abs(uniforms.dualGainTimestampSkew));
    return clamp(photometricConfidence * flowConfidence * timestampConfidence, 0.0, 1.0);
}

uint motionCompensatedBilateralTemporalBlend(uint sampleIndex, uint currentValue, bool chromaSample) {
    if (pushData.hasPreviousFrame == 0u) return currentValue;
    float boundaryGuard = 0.0;
    uint previousIndex = chromaSample ? sampleIndex : motionCompensatedPreviousIndex(sampleIndex, boundaryGuard);
    if (chromaSample) boundaryGuard = 1.0;
    uint previousValue = unpackP010(readPreviousP010Sample(previousIndex));
    float currentNorm = float(currentValue) / 1023.0;
    float previousNorm = float(previousValue) / 1023.0;
    float colorSigma = mix(0.018, 0.075, p010ExportNoiseShape());
    float colorDistance = currentNorm - previousNorm;
    float bilateralWeight = exp(-(colorDistance * colorDistance) / max(2.0 * colorSigma * colorSigma, 0.000001));
    float legacyWeight = chromaSample ? uniforms.temporalChromaBlend : uniforms.temporalLumaBlend;
    float flowMagnitude = chromaSample ? 0.0 : length(neuralOpticalFlowVector(sampleIndex));
    float motionConfidence = p010TemporalMotionConfidence(currentValue, previousValue, flowMagnitude, chromaSample);

    // Strict beyond-IMAX high-end motion blur suppression gate
    float strictMotionSuppress = exp(-max(abs(currentNorm - previousNorm) - 0.002, 0.0) * 150.0);
    if (flowMagnitude > 0.04) {
        strictMotionSuppress *= exp(-max(flowMagnitude - 0.04, 0.0) * 85.0);
    }
    motionConfidence *= strictMotionSuppress;

    if (!p010BoundedNormalProSdrExport()) {
        float legacyAlpha = clamp(legacyWeight * bilateralWeight * boundaryGuard, 0.0, 1.0) * motionConfidence;
        return blendSample(currentValue, previousValue, legacyAlpha);
    }
    float baseAlpha = p010NormalizeStrength(legacyWeight);
    float temporalCap = chromaSample ? 0.64 : P010_MAX_TEMPORAL_PREVIOUS_WEIGHT;
    // Apply a SINGLE ceiling (the tightest cap) then modulate by the confidence
    // terms. Previously the two cap terms were MULTIPLIED —
    // min(baseAlpha,MAX)*min(temporalCap,MAX) — squaring them: with baseAlpha=1
    // and temporalCap=MAX=0.72 the realized previous-frame weight was 0.72*0.72=
    // 0.518, far below the intended 0.72 ceiling, leaving more residual temporal
    // shimmer than designed on static shots (audit rank 19).
    float cappedAlpha = min(min(baseAlpha, temporalCap), P010_MAX_TEMPORAL_PREVIOUS_WEIGHT);
    float alphaTemp = clamp(
        cappedAlpha * bilateralWeight * boundaryGuard * motionConfidence,
        0.0,
        P010_MAX_TEMPORAL_PREVIOUS_WEIGHT
    );
    return blendSample(currentValue, previousValue, alphaTemp);
}

// Real block-match optical flow in P010 luma space (NPV10 export). Searches the bound previous frame
// for the best SAD-matching 3x3 patch within a +/-RADIUS window -> a genuine per-pixel motion vector
// (replaces the analytic gyro-phase estimate for the deblur). Heavy by design (owner directive: real
// flow, not approximation); offline export only. Returns zero flow when no previous frame is bound.
vec2 rivenBlockMatchFlow(uint lumaIndex) {
    if (pushData.hasPreviousFrame == 0u) return vec2(0.0);
    const int RADIUS = 3;
    const int PATCH = 1;
    int tileX = int(gl_LocalInvocationID.x) + RIVEN_TILE_HALO;
    int tileY = int(gl_LocalInvocationID.y) + RIVEN_TILE_HALO;
    float bestSad = 1e20;
    vec2 bestFlow = vec2(0.0);
    for (int dy = -RADIUS; dy <= RADIUS; ++dy) {
        for (int dx = -RADIUS; dx <= RADIUS; ++dx) {
            float sad = 0.0;
            for (int py = -PATCH; py <= PATCH; ++py) {
                for (int px = -PATCH; px <= PATCH; ++px) {
                    int currentTileIndex = (tileY + py) * RIVEN_TILE_EDGE + tileX + px;
                    int previousTileIndex =
                        (tileY + py + dy) * RIVEN_TILE_EDGE + tileX + px + dx;
                    float cur = float(rivenCurrentLumaTile[currentTileIndex]);
                    float prv = float(rivenPreviousLumaTile[previousTileIndex]);
                    sad += abs(cur - prv);
                }
            }
            if (sad < bestSad) {
                bestSad = sad;
                bestFlow = vec2(float(dx), float(dy));
                // P010 sample differences are exact non-negative integers. Zero is the global SAD
                // minimum, so no later candidate can beat it under the strict `<` tie rule. This
                // exits only provably redundant work and leaves every selected vector/output bit exact.
                if (bestSad == 0.0) return bestFlow;
            }
        }
    }
    return bestFlow;
}

// OmniClarity §4 Riven directional motion-deblur in P010 luma space (NPV10 export path).
// Models intra-frame motion blur as a 1D line kernel along the export's analytic motion flow and
// applies a Wiener-regularized directional inverse, ringing-clamped to the local line extremes.
// No-op where there is no measurable motion (passes the luma through unchanged). Driven by the
// export's analytic flow (neuralOpticalFlowVector), not the full Argus pyramid — bounded + safe.
uint rivenP010LumaDeblur(uint lumaIndex, uint centerValue) {
    uint width = max(pushData.width, 1u);
    uint height = max(pushData.height, 1u);
    uint x = lumaIndex - (lumaIndex / width) * width;
    uint y = lumaIndex / width;
    vec2 flow = rivenBlockMatchFlow(lumaIndex);
    float speed = length(flow);
    float exposureFraction = clamp(uniforms.temporalLumaBlend, 0.1, 1.0);
    float kernelLength = min(speed * exposureFraction * 2.5, 12.0);
    const float minKernel = 1.5;
    if (kernelLength < minKernel || speed < 1e-5) {
        return centerValue;
    }
    vec2 dir = flow / speed;
    const int TAPS = 12;
    float center = float(centerValue);
    float acc = 0.0;
    float lineMin = center;
    float lineMax = center;
    for (int i = 0; i < TAPS; ++i) {
        float t = (float(i) / float(TAPS - 1) - 0.5) * kernelLength;
        vec2 c = vec2(float(x), float(y)) + dir * t;
        uint cx = uint(clamp(c.x + 0.5, 0.0, float(width - 1u)));
        uint cy = uint(clamp(c.y + 0.5, 0.0, float(height - 1u)));
        int tileX = int(cx) - int(gl_WorkGroupID.x) * RIVEN_WORKGROUP_EDGE + RIVEN_TILE_HALO;
        int tileY = int(cy) - int(gl_WorkGroupID.y) * RIVEN_WORKGROUP_EDGE + RIVEN_TILE_HALO;
        float tap = float(rivenCurrentLumaTile[tileY * RIVEN_TILE_EDGE + tileX]);
        acc += tap;
        lineMin = min(lineMin, tap);
        lineMax = max(lineMax, tap);
    }
    float blurEstimate = acc / float(TAPS);
    float residual = center - blurEstimate;
    float variance = heteroscedasticNoiseVariance(center / 1023.0);
    float snrInverse = sqrt(max(variance, 0.0));
    float noiseReg = 1.0 / (1.0 + snrInverse * 4.0);
    float lengthGate = smoothstep(minKernel, minKernel * 3.0 + 1e-4, kernelLength);
    float gain = 0.6 * lengthGate * noiseReg;
    float deblurred = clamp(center + gain * residual, lineMin, lineMax);
    return uint(clamp(deblurred + 0.5, 0.0, 1023.0));
}

