// s2-f11 / CP40: exact NeoWideGamut primary-triangle boundary in CIE xy. When the
// USE_EXACT_GAMUT_BOUNDARY spec constant is enabled (device-gated), this replaces the analytic
// 3-fold cosine guess with the true distance from the white point to the gamut triangle edge.
// Mirrors com.neoproc.neoproccamx.color.NeoGamutXyBoundary (host reference / unit tests).
layout(constant_id = 0) const bool USE_EXACT_GAMUT_BOUNDARY = true; // Default ON (user-directed 2026-07-04, device-verified): exact NeoWideGamut xy triangle boundary on the record/export path — matches the approved default-ON preview Oklab cusp (e013f02/4eec946)

float exactGamutBoundaryRadius(vec2 center, float angle) {
    vec2 prim[3] = vec2[3](
        vec2(0.7347024, 0.2652976),  // R
        vec2(0.1151875, 0.8259494),  // G
        vec2(0.0859901, 0.0110001)   // B
    );
    vec2 d = vec2(cos(angle), sin(angle));
    float best = 1e9;
    for (int k = 0; k < 3; ++k) {
        vec2 p = prim[k];
        vec2 e = prim[(k + 1) % 3] - p;
        float det = -d.x * e.y + e.x * d.y;
        if (abs(det) < 1e-9) continue;
        vec2 r = p - center;
        float t = (-r.x * e.y + e.x * r.y) / det;
        float s = (d.x * r.y - d.y * r.x) / det;
        if (t > 0.0 && s >= 0.0 && s <= 1.0 && t < best) best = t;
    }
    return best;
}

vec3 neoWideGamutCompressXyPreserveY(vec3 xyz) {
    float sumXyz = max(xyz.x + xyz.y + xyz.z, 1e-6);
    vec2 xy = xyz.xy / sumXyz;
    vec2 center = vec2(0.3324, 0.3474);
    vec2 delta = xy - center;
    float radius = length(delta);
    float angle = atan(delta.y, delta.x);
    float softBoundary = USE_EXACT_GAMUT_BOUNDARY
        ? exactGamutBoundaryRadius(center, angle)
        : clamp(0.365 + 0.080 * cos(3.0 * angle) + 0.035 * cos(6.0 * angle + 0.4), 0.18, 0.48);
    if (radius > softBoundary) {
        float excess = radius - softBoundary;
        xy = center + normalize(delta) * softBoundary * (1.0 - 0.025 * (1.0 - exp(-excess * 6.0)));
    }
    float safeY = max(xy.y, 1e-5);
    return vec3(xy.x * xyz.y / safeY, xyz.y, (1.0 - xy.x - xy.y) * xyz.y / safeY);
}

