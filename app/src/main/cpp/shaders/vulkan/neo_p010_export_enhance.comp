}

float highEntropyPlanckBlueNoiseTexture(uint sampleIndex) {
    uint width = max(pushData.width, 1u);
    uint x = sampleIndex - (sampleIndex / width) * width;
    uint y = sampleIndex / width;
    uint hash = x * 1664525u + y * 1013904223u + uint(uniforms.temporalBlend * 65535.0);
    hash ^= hash >> 13u;
    hash *= 1274126177u;
    uint matrixIndex = ((hash >> 3u) & 63u);
    return (float(BLUE_NOISE_8X8[int(matrixIndex)]) - 31.5) / 31.5;
}

float jndShapedQuantizationError(uint sampleIndex, uint sampleValue) {
    if (p010ZeroVisibleGrainExport()) return 0.0;
    float highEntropyBlue = highEntropyPlanckBlueNoiseTexture(sampleIndex);
