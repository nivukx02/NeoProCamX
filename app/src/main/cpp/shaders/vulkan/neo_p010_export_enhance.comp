    uint y = sampleIndex / width;
    uint matrixIndex = (((x * 5u + y * 3u) & 7u) << 3u) + ((x * 3u + y * 7u) & 7u);
    float grain = (float(BLUE_NOISE_8X8[int(matrixIndex)]) - 31.5) / 31.5;
    float jnd = planckBlueNoiseJndThreshold(sampleValue) * 0.38;
