// ════════════════════════════════════════════════════════════════════════════
//  NDR10+ / NIVUKX genuine full-RGB → PQ delivery engine (Phase 1)
//  GLSL port of com.neoproc.neoproccamx.color.NdrNivukxDeliveryEngine, composed
//  with limited-range BT.2020 Y'CbCr <-> R'G'B' and HLG->scene-linear so the
//  profile's OWN color science reaches recorded pixels as real PQ.
// ════════════════════════════════════════════════════════════════════════════

const float NEO_KR = 0.2627;
const float NEO_KG = 0.6780;
const float NEO_KB = 0.0593;
// HLG signal at diffuse white (75%) mapped to scene-linear via the inverse OETF.
// Dividing scene-linear by this anchors diffuse white to engine input 1.0.
const float NEO_HLG_DIFFUSE_SCENE = 0.264967;

float neoPqLuma(vec3 c) { return dot(c, vec3(NEO_KR, NEO_KG, NEO_KB)); }

// Limited-range 10-bit BT.2020 NCL Y'CbCr code -> non-linear R'G'B' [0,1]-ish.
vec3 neoPqYcbcrCodeToRgb(float yCode, float cbCode, float crCode) {
    float Y = clamp((yCode - 64.0) / 876.0, 0.0, 1.0);
    float Pb = (cbCode - 512.0) / 896.0;
    float Pr = (crCode - 512.0) / 896.0;
    return vec3(
        Y + 1.4746 * Pr,
        Y - 0.16455 * Pb - 0.57135 * Pr,
        Y + 1.8814 * Pb
    );
}

// Non-linear R'G'B' [0,1] -> limited-range 10-bit BT.2020 NCL codes.
float neoPqRgbToYCode(vec3 c) { return neoPqLuma(c) * 876.0 + 64.0; }
vec2 neoPqRgbToChromaCodes(vec3 c) {
    float Y = neoPqLuma(c);
    return vec2(
        (c.b - Y) / 1.8814 * 896.0 + 512.0,  // Cb
        (c.r - Y) / 1.4746 * 896.0 + 512.0   // Cr
    );
}

// BT.2100 HLG inverse OETF: signal -> scene linear [0,1].
float neoPqHlgInvOetf(float e) {
    e = clamp(e, 0.0, 1.0);
    return e <= 0.5
        ? (e * e / 3.0)
        : ((exp((e - 0.55991073) / 0.17883277) + 0.28466892) / 12.0);
}

vec3 neoPqHlgSignalToEngineLinear(vec3 e) {
    return vec3(neoPqHlgInvOetf(e.r), neoPqHlgInvOetf(e.g), neoPqHlgInvOetf(e.b)) /
        NEO_HLG_DIFFUSE_SCENE;
}

float neoDelSmoothstep(float e0, float e1, float x) {
    if (e0 == e1) return x >= e1 ? 1.0 : 0.0;
    float t = clamp((x - e0) / (e1 - e0), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

// NdrToneOperator.signalShape: gamma lift + fading toe, C1 linear past diffuse white.
float neoDelSignalShape(float x, float g, float toeW, float toeA) {
    if (x <= 0.0) return 0.0;
    if (x <= 1.0) return pow(x, g) + neoDelSmoothstep(0.0, toeW, x) * toeA * (1.0 - x);
    return 1.0 + (g - toeA) * (x - 1.0);
}

// NdrToneOperator.signalToDisplayNits: 203-nit diffuse anchor + C1 exp shoulder to peak.
float neoDelSignalToNits(float signal, float diffuse, float peak) {
    float s = max(signal, 0.0);
    float raw = s * diffuse;
    if (raw <= diffuse) return raw;
    float range = peak - diffuse;
    return min(diffuse + range * (1.0 - exp(-(raw - diffuse) / range)), peak);
}

// ST.2084 (PQ) OETF from absolute nits.
float neoDelPqFromNits(float nits) {
    float y = clamp(nits / 10000.0, 0.0, 1.0);
    float ym = pow(y, 0.1593017578125);            // M1 = 2610/16384
    return pow((0.8359375 + 18.8515625 * ym) / (1.0 + 18.6875 * ym), 78.84375); // C1,C2,C3 / M2
}

vec3 neoCompressPeakColorVolume(vec3 rgbNits, float luminanceNits, float peakNits) {
    float peak = clamp(peakNits, 203.0, 10000.0);
    float y = clamp(luminanceNits, 0.0, peak);
    vec3 rgb = max(rgbNits, vec3(0.0));
    float hi = max(max(rgb.r, rgb.g), rgb.b);
    if (hi <= peak || hi <= y + 1e-8) return rgb;
    float chromaScale = clamp((peak - y) / (hi - y), 0.0, 1.0);
    return clamp(vec3(y) + (rgb - vec3(y)) * chromaScale, 0.0, peak);
}

// NdrToneOperator.mapRgbHuePreserving: luma-preserving scale + radial highlight desat.
vec3 neoDelMapRgbHuePreserving(vec3 lin, float g, float toeW, float toeA, float desatCap) {
    vec3 s = max(lin, vec3(0.0));
    float y = max(neoPqLuma(s), 1e-8);
    float mappedY = neoDelSignalShape(y, g, toeW, toeA);
    vec3 o = s * (mappedY / y);
    float desat = clamp(desatCap * neoDelSmoothstep(0.55, 1.0, mappedY), 0.0, desatCap);
    o = mix(o, vec3(mappedY), desat);              // toward neutral (hue-constant)
    return max(o, vec3(0.0));
}

// Linear BT.2020 RGB (1.0 == diffuse white) -> PQ R'G'B'. mode 1 = NIVUKX, else NDR10+.
vec3 neoDeliverPq(vec3 lin, int mode) {
    float g      = mode == 1 ? 0.88 : 0.92;
    float toeW   = mode == 1 ? 0.24 : 0.20;
    float toeA   = mode == 1 ? 0.026 : 0.018;
    float peak   = mode == 1 ? 10000.0 : 5000.0;
    float desat  = mode == 1 ? 0.26 : 0.20;
    vec3 t = neoDelMapRgbHuePreserving(lin, g, toeW, toeA, desat);
    float sl = max(neoPqLuma(t), 1e-8);
    float nits = neoDelSignalToNits(sl, 203.0, peak);
    float sc = nits / sl;
    vec3 peakSafe = neoCompressPeakColorVolume(t * sc, nits, peak);
    return vec3(
        neoDelPqFromNits(peakSafe.r),
        neoDelPqFromNits(peakSafe.g),
        neoDelPqFromNits(peakSafe.b)
    );
}

// Spatial/temporal detail recovery on the luma code WITHOUT the old luma "look"
// stages (the color engine below owns tone). Reuses the proven Apex detail lanes.
uint neoPqDetailLuma(uint lumaIndex, uint yValue) {
    uint p = motionCompensatedBilateralTemporalBlend(lumaIndex, yValue, false);
    p = applyEdgeAwareDetailLift(lumaIndex, p);
    p = applyApexMicroTextureRecover(lumaIndex, p);
    p = applyApexLocalContrastLuma(lumaIndex, p);
    p = applyApexShadowNoiseFloorLuma(lumaIndex, p);
    p = applyApexHighlightTextureLuma(lumaIndex, p);
    p = applyApexEdgeCoherenceLuma(lumaIndex, p);
    p = applyApexTonalDensityLuma(lumaIndex, p);
    p = applyApexLongDistanceDetailLuma(lumaIndex, p);
    return p;
}

void main() {
    // This call contains a workgroup barrier and therefore must execute before edge invocations return.
    loadRivenLumaTiles();
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= pushData.width || y >= pushData.height) return;

    uint lumaIndex = y * pushData.width + x;
    uint yValue = unpackP010(readCurrentP010Sample(lumaIndex));
    bool neoAcesColorSpace = int(uniforms.colorSpace + 0.5) == COLOR_SPACE_NEO_ACES_AP1 ||
        int(uniforms.colorSpace + 0.5) == COLOR_SPACE_NEO_ACES_AP0;

    // ── Genuine NDR10+/NIVUKX full-RGB → PQ delivery (Phase 2, active) ────────
    // Reconstruct real RGB (luma + co-sited block chroma), run the canonical
    // color engine, re-encode to PQ Y'CbCr. Replaces the gray-fed luma curve so
    // the profile's OWN color science reaches recorded pixels. Active in Phase 2
    // NEO_PQ_DELIVERY_ENABLED must remain zero: NDR/NIVUKX accepts RAW-derived ACEScg only.
    int neoDeliveryCs = int(uniforms.colorScience + 0.5);
    if (NEO_PQ_DELIVERY_ENABLED == 1 &&
        int(uniforms.activeTransport + 0.5) == ACTIVE_TRANSPORT_BT2100_PQ &&
        (neoDeliveryCs == COLOR_SCIENCE_NIVUKX_VISION ||
            neoDeliveryCs == COLOR_SCIENCE_COSMIC_SINGULARITY)) {
        int neoMode = (neoDeliveryCs == COLOR_SCIENCE_NIVUKX_VISION) ? 1 : 0;
        uint neoChromaWidth = (pushData.width + 1u) / 2u;
        uint neoChromaHeight = (pushData.height + 1u) / 2u;
        uint neoBlockX = x / 2u;
        uint neoBlockY = y / 2u;
        uint neoChromaPair =
            pushData.width * pushData.height + (neoBlockY * neoChromaWidth + neoBlockX) * 2u;
        uint neoU = unpackP010(readCurrentP010Sample(neoChromaPair));
        uint neoV = unpackP010(readCurrentP010Sample(neoChromaPair + 1u));

        // Per-pixel luma: detail-enhance, reconstruct RGB with the block chroma,
        // deliver PQ, take its luma back to a limited-range code.
        uint neoDetailY = neoPqDetailLuma(lumaIndex, yValue);
        vec3 neoSignalRgb = neoPqYcbcrCodeToRgb(float(neoDetailY), float(neoU), float(neoV));
        vec3 neoLinear = neoPqHlgSignalToEngineLinear(neoSignalRgb);
        vec3 neoPqRgb = neoDeliverPq(neoLinear, neoMode);
        uint neoOutY = uint(clamp(neoPqRgbToYCode(neoPqRgb) + 0.5, 0.0, 1023.0));
        neoOutY = rivenP010LumaDeblur(lumaIndex, neoOutY);
        writePackedP010Sample(lumaIndex, neoOutY);

        // Per-block chroma: derive new Cb/Cr from the block-average RGB (top-left
        // invocation only, matching the 4:2:0 write pattern).
        if ((x & 1u) == 0u && (y & 1u) == 0u &&
            neoBlockX < neoChromaWidth && neoBlockY < neoChromaHeight) {
            uint neoY00 = unpackP010(readCurrentP010Sample(lumaIndex));
            uint neoY01 = (x + 1u < pushData.width)
                ? unpackP010(readCurrentP010Sample(lumaIndex + 1u)) : neoY00;
            uint neoY10 = (y + 1u < pushData.height)
                ? unpackP010(readCurrentP010Sample(lumaIndex + pushData.width)) : neoY00;
            uint neoY11 = (x + 1u < pushData.width && y + 1u < pushData.height)
                ? unpackP010(readCurrentP010Sample(lumaIndex + pushData.width + 1u)) : neoY00;
            float neoYAvg = 0.25 * (float(neoY00) + float(neoY01) + float(neoY10) + float(neoY11));
            uint neoNeighborU = chromaNeighborAverage(neoChromaWidth, neoChromaHeight, neoBlockY, neoBlockX, 0u);
            uint neoNeighborV = chromaNeighborAverage(neoChromaWidth, neoChromaHeight, neoBlockY, neoBlockX, 1u);
            uint neoDenoisedU = applyLocalChromaSpikeSmoothing(applyChromaDeadband(neoU, neoNeighborU), neoNeighborU);
            uint neoDenoisedV = applyLocalChromaSpikeSmoothing(applyChromaDeadband(neoV, neoNeighborV), neoNeighborV);
            vec3 neoBlockSignal = neoPqYcbcrCodeToRgb(neoYAvg, float(neoDenoisedU), float(neoDenoisedV));
            vec3 neoBlockLinear = neoPqHlgSignalToEngineLinear(neoBlockSignal);
            vec3 neoBlockPq = neoDeliverPq(neoBlockLinear, neoMode);
            vec2 neoChromaCodes = neoPqRgbToChromaCodes(neoBlockPq);
            writePackedP010Sample(neoChromaPair, uint(clamp(neoChromaCodes.x + 0.5, 0.0, 1023.0)));
            writePackedP010Sample(neoChromaPair + 1u, uint(clamp(neoChromaCodes.y + 0.5, 0.0, 1023.0)));
        }
        return;
    }

    if (int(uniforms.colorScience + 0.5) == COLOR_SCIENCE_NIVUKX_VISION) {
        yValue = processNivukxApexPipeline(lumaIndex, yValue);
    } else if (neoAcesColorSpace || int(uniforms.colorScience + 0.5) == COLOR_SCIENCE_NEO_ACES_HIGH_END) {
        yValue = processNeoAcesHighEndPipeline(lumaIndex, yValue);
    } else if (int(uniforms.colorScience + 0.5) == COLOR_SCIENCE_COSMIC_SINGULARITY) {
        yValue = processCosmicSingularityPipeline(lumaIndex, yValue);
    } else {
        yValue = processStandardCinemaPipeline(lumaIndex, yValue);
    }
    // OmniClarity Riven directional motion-deblur (NPV10 export). No-op without measurable motion.
    yValue = rivenP010LumaDeblur(lumaIndex, yValue);
    writePackedP010Sample(lumaIndex, yValue);

    uint chromaWidth = (pushData.width + 1u) / 2u;
    uint chromaHeight = (pushData.height + 1u) / 2u;
    if ((x & 1u) == 0u && (y & 1u) == 0u && x / 2u < chromaWidth && y / 2u < chromaHeight) {
        uint chromaRow = y / 2u;
        uint chromaColumn = x / 2u;
        uint chromaPairIndex = pushData.width * pushData.height + (chromaRow * chromaWidth + chromaColumn) * 2u;
        uint uValue = unpackP010(readCurrentP010Sample(chromaPairIndex));
        uint vValue = unpackP010(readCurrentP010Sample(chromaPairIndex + 1u));
        uint neighborU = chromaNeighborAverage(chromaWidth, chromaHeight, chromaRow, chromaColumn, 0u);
        uint neighborV = chromaNeighborAverage(chromaWidth, chromaHeight, chromaRow, chromaColumn, 1u);
        uValue = motionCompensatedBilateralTemporalBlend(chromaPairIndex, uValue, true);
        vValue = motionCompensatedBilateralTemporalBlend(chromaPairIndex + 1u, vValue, true);
        uValue = applyChromaDeadband(uValue, neighborU);
        vValue = applyChromaDeadband(vValue, neighborV);
        uValue = applyLocalChromaSpikeSmoothing(uValue, neighborU);
        vValue = applyLocalChromaSpikeSmoothing(vValue, neighborV);
        // SNCE v2.0 HVC perceptual chroma nudge (reaches recorded + NPV10-exported pixels).
        // saturation (slot 11) scales chroma about neutral 512 — Hunt low-light colourfulness;
        // warmth (slot 9) biases U/V to approximate the SNCE residual-WB correction. Both are
        // NO-OP at saturation==1, warmth==0, and hard-clamped so a bad value cannot corrupt chroma.
        float snceSat = clamp(uniforms.saturation, 0.5, 2.0);
        float snceWarmth = clamp(uniforms.warmth, -0.2, 0.2);
        float snceU = (float(uValue) - 512.0) * snceSat - snceWarmth * 220.0;
        float snceV = (float(vValue) - 512.0) * snceSat + snceWarmth * 220.0;
        uValue = uint(clamp(512.0 + snceU + 0.5, 0.0, 1023.0));
        vValue = uint(clamp(512.0 + snceV + 0.5, 0.0, 1023.0));
        writePackedP010Sample(chromaPairIndex, uValue);
        writePackedP010Sample(chromaPairIndex + 1u, vValue);
    }
}
