#version 450

// Offline RAW conversion stage 1. This is the GPU equivalent of
// RawDevelopEliteDetailPolicy's edge-aware 3x3 denoise. The source is the
// full-resolution scene-linear ACEScg image produced by demosaic_vulkan.comp.
// rgba32f is intentional: conversion must not add another FP16 quantization.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba16f) uniform readonly image2D acescgInput;
layout(binding = 1, rgba32f) uniform writeonly image2D denoisedOutput;

layout(push_constant) uniform RawDevelopDetailPushConstants {
    int width;
    int height;
    int detailEnabled;
    int reserved;
} p;

const vec3 ACESCG_LUMA = vec3(0.2722287168, 0.6740817658, 0.0536895174);
const float DENOISE_STRENGTH = 0.35;
const float DENOISE_LUMA_SIGMA = 0.05;
const float EPSILON = 0.00001;

float luma(vec3 rgb) {
    return dot(rgb, ACESCG_LUMA);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= p.width || pixel.y >= p.height) return;

    vec3 center = imageLoad(acescgInput, pixel).rgb;
    if (p.detailEnabled == 0 || p.width < 3 || p.height < 3) {
        imageStore(denoisedOutput, pixel, vec4(max(center, vec3(0.0)), 1.0));
        return;
    }

    float centerLuma = luma(center);
    float invTwoSigma2 = 1.0 /
        (2.0 * DENOISE_LUMA_SIGMA * DENOISE_LUMA_SIGMA);
    float weightSum = 0.0;
    vec3 sum = vec3(0.0);
    int x0 = max(pixel.x - 1, 0);
    int x1 = min(pixel.x + 1, p.width - 1);
    int y0 = max(pixel.y - 1, 0);
    int y1 = min(pixel.y + 1, p.height - 1);
    for (int y = y0; y <= y1; ++y) {
        for (int x = x0; x <= x1; ++x) {
            vec3 sampleRgb = imageLoad(acescgInput, ivec2(x, y)).rgb;
            float delta = centerLuma - luma(sampleRgb);
            float weight = exp(-(delta * delta) * invTwoSigma2);
            weightSum += weight;
            sum += sampleRgb * weight;
        }
    }
    vec3 filtered = center;
    if (weightSum > EPSILON) {
        filtered = center + (sum / weightSum - center) * DENOISE_STRENGTH;
    }
    imageStore(denoisedOutput, pixel, vec4(max(filtered, vec3(0.0)), 1.0));
}
