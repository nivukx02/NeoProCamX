#version 320 es
precision highp float;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba16f) readonly uniform highp image2D uInputImage;
layout(binding = 1, rgba16f) writeonly uniform highp image2D uOutputImage;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    vec4 src = imageLoad(uInputImage, coord);
    float luma = dot(src.rgb, vec3(0.299, 0.587, 0.114));
    imageStore(uOutputImage, coord, vec4(vec3(luma), 1.0));
}
